NEXT_PUBLIC_STUDIO_URL=http://127.0.0.1:3030
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:62321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_anon_or_publishable_key
# No service role is required by Studio. Use the existing ELSATIA Auth project when deployed.
# Server only: never prefix with NEXT_PUBLIC, never expose to a browser.
STUDIO_STORAGE_SERVICE_KEY=replace-with-server-only-storage-credential

# Optional local analysis: no external API credential required. Default OFF.
STUDIO_AI_ANALYSIS=0
# Worker only: absolute path to Python with analysis/requirements.txt installed.
STUDIO_ANALYSIS_PYTHON=
STUDIO_ANALYSIS_CONCURRENCY=1
STUDIO_ANALYSIS_TIMEOUT_SECONDS=120
