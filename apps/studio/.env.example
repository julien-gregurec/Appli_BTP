NEXT_PUBLIC_STUDIO_URL=http://127.0.0.1:3030
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:62321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_anon_or_publishable_key
# No service role is required by Studio. Use the existing ELSATIA Auth project when deployed.
# Server only: never prefix with NEXT_PUBLIC, never expose to a browser.
STUDIO_STORAGE_SERVICE_KEY=replace-with-server-only-storage-credential

# Optional local analysis: no external API credential required. Default OFF.
STUDIO_AI_ANALYSIS=0
# Worker only: absolute path to Python with analysis/requirements.txt installed.
STUDIO_ANALYSIS_PYTHON=

# Kill switch for the whole Studio web surface: 0/false/off returns 503 everywhere.
# Not yet read by application code (config/env-manifest.json, F-STUDIO-* — declared ahead of wiring).
STUDIO_ENABLED=1
# Signup policy: open | allowlist | closed. Preview/production must set this explicitly
# (manifest: must_be_defined_in preview,production); production's target value is an open
# product decision (DECISION_REQUIRED:STUDIO-SIGNUP-DEFAULT). Not yet read by application code.
STUDIO_SIGNUP_MODE=closed
# Only used when STUDIO_SIGNUP_MODE=allowlist. Comma-separated addresses or @domains.
STUDIO_SIGNUP_ALLOWLIST=
# Studio's legal/consent flow is published. Preview/production must set this explicitly
# (manifest: must_be_defined_in preview,production). Not yet read by application code.
STUDIO_LEGAL_PUBLISHED=1
# Version tag of the legal text shown at acceptance. Not yet read by application code
# (no version display is implemented) — manifest requirement relaxed to optional accordingly.
STUDIO_LEGAL_TEXT_VERSION=v1

# Studio transactional email. mailpit is the local dev catch-all; resend requires RESEND_API_KEY.
STUDIO_MAIL_PROVIDER=mailpit
STUDIO_MAIL_FROM=studio@example.com
# Only used when STUDIO_MAIL_PROVIDER=resend. Secret: never commit a real value.
RESEND_API_KEY=
