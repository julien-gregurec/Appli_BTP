NEXT_PUBLIC_STUDIO_URL=http://127.0.0.1:3030
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:62321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_anon_or_publishable_key
# No service role is required by Studio. Use the existing ELSATIA Auth project when deployed.
# Server only: never prefix with NEXT_PUBLIC, never expose to a browser.
STUDIO_STORAGE_SERVICE_KEY=replace-with-server-only-storage-credential

# Optional local analysis: no external API credential required. Default OFF.
STUDIO_AI_ANALYSIS=0
# Worker only: absolute path to Python with analysis/requirements.txt installed.
STUDIO_ANALYSIS_PYTHON=

# Kill switch for the whole Studio web surface: 0/false/off returns 503 everywhere
# (apps/studio/src/proxy.ts, studioEnabled()). Fail-open by design: absent = active.
STUDIO_ENABLED=1
# Signup policy: open | allowlist | closed (apps/studio/src/app/actions.ts, signup()).
# FAIL-CLOSED: absent or unrecognized = closed. Preview/production must set this explicitly;
# production's target value is an open product decision (DECISION_REQUIRED:STUDIO-SIGNUP-DEFAULT).
STUDIO_SIGNUP_MODE=closed
# Only used when STUDIO_SIGNUP_MODE=allowlist. Comma-separated addresses or @domains.
# FAIL-CLOSED: empty or absent allows nobody.
STUDIO_SIGNUP_ALLOWLIST=
# Gates new account creation in signup() — FAIL-CLOSED, "1" required. Not a full legal/consent
# page: none exists in the code yet. Preview/production must set this explicitly.
STUDIO_LEGAL_PUBLISHED=1
