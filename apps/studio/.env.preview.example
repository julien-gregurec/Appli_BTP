# ELSATIA Studio — exemple Vercel Preview isolé.
# Aucun secret réel. Remplacer uniquement dans les variables Vercel du projet Preview Studio.
# Ferme le P1 audit (ELSATIA_REAL_PREVIEW_READINESS_AUDIT_V2 §1.4, §7) : Studio n'avait aucun
# gabarit Preview dédié, seul .env.example (gabarit de développement local).
#
# Décision non tranchée avant d'exposer Studio en Preview : DECISION_REQUIRED:STUDIO-DEDICATED-
# SUPABASE-AND-CONTINUATION (config/env-manifest.json) — projet Supabase partagé avec
# GP/Colors/Tools/Reserves ou projet dédié. Les valeurs Supabase ci-dessous dépendent de ce choix.

NEXT_PUBLIC_STUDIO_URL=https://<preview-host-studio>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Aucun rôle de service requis côté web. Utiliser le projet Supabase retenu par la décision
# ci-dessus. Server only: jamais préfixée NEXT_PUBLIC_, jamais exposée au navigateur.
STUDIO_STORAGE_SERVICE_KEY=

# Analyse locale optionnelle : aucun credential externe. Désactivée par défaut — laisser à 0
# tant que l'hébergement du worker d'analyse (Python) n'est pas décidé (voir
# docs/runbooks/ELSATIA_STUDIO_VIDEO_WORKER_DEPLOYMENT_V1.md §3, point 8).
STUDIO_AI_ANALYSIS=0
STUDIO_ANALYSIS_PYTHON=

# Coupe-circuit de toute la surface web Studio : 0/false/off renvoie 503 partout
# (apps/studio/src/proxy.ts, studioEnabled()). Fail-open par conception : absent = actif.
STUDIO_ENABLED=1
# Politique d'inscription : open | allowlist | closed (apps/studio/src/app/actions.ts, signup()).
# FAIL-CLOSED : absent ou non reconnu = closed. Valeur conservatrice retenue ici tant que
# DECISION_REQUIRED:STUDIO-SIGNUP-DEFAULT n'est pas tranchée. Même avec cette variable à
# "closed", l'inscription reste contournable par un appel direct à l'API Auth de Supabase tant
# que DECISION_REQUIRED:STUDIO-DEDICATED-SUPABASE-AND-CONTINUATION n'est pas résolue — ne pas
# exposer cette Preview publiquement avant cela (voir le rapport de clôture des blockers).
STUDIO_SIGNUP_MODE=closed
# Utilisée seulement si STUDIO_SIGNUP_MODE=allowlist. Adresses ou @domaines séparés par virgule.
# FAIL-CLOSED : vide ou absente = personne n'est autorisé.
STUDIO_SIGNUP_ALLOWLIST=
# Verrouille la création de compte dans signup() — FAIL-CLOSED, "1" requis. Ne constitue pas une
# page légale/consentement complète : aucune n'existe encore dans le code.
STUDIO_LEGAL_PUBLISHED=1
