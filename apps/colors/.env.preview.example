# ELSATIA Colors — exemple Vercel Preview isolé.
# Aucun secret réel. Remplacer uniquement dans les variables Vercel du projet Preview Colors.
# Ferme le P1 audit (ELSATIA_REAL_PREVIEW_READINESS_AUDIT_V2 §1.4, §7) : Colors n'avait aucun
# gabarit Preview dédié, seul .env.example (gabarit de développement local).

# Convention unique de l'écosystème ELSATIA : la clé publique Supabase est portée par
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. NEXT_PUBLIC_SUPABASE_ANON_KEY est abandonnée et n'est
# acceptée en repli nulle part : les clés JWT legacy sont désactivées côté projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ELSATIA_ACCOUNT_URL=https://<preview-host-gp>/abonnement
NEXT_PUBLIC_COLORS_URL=https://<preview-host-colors>
# Sélectionne les URL du catalogue multi-app : preview ici, jamais local en dehors du poste de
# développement. Sans elle, la garde de pré-déploiement (scripts/verify-public-env.mjs) traite
# le build comme publié et l'interrompt.
ELSATIA_APPLICATION_ENV=preview
# [obligatoire pour les photos] [serveur] — clé service_role, Storage uniquement
# (createAdminStorageClient). Serveur seul : jamais publique, jamais dans next.config.
SUPABASE_SERVICE_ROLE_KEY=
