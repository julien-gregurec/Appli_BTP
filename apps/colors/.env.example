NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_ELSATIA_ACCOUNT_URL=http://localhost:3000/abonnement
NEXT_PUBLIC_COLORS_URL=http://localhost:3010
# Requis côté serveur pour le stockage admin et le limiteur anti-bruteforce MFA.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Secret HMAC partagé avec Gestion Pro pour le hachage des identifiants de
# rate limiting. Obligatoire en production ; en dev un repli local est utilisé.
RATE_LIMIT_HMAC_KEY=
