# Convention unique de l'écosystème ELSATIA : la clé publique Supabase est portée par
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. NEXT_PUBLIC_SUPABASE_ANON_KEY est abandonnée et n'est
# acceptée en repli nulle part : les clés JWT legacy sont désactivées côté projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_ELSATIA_ACCOUNT_URL=http://localhost:3000/abonnement
NEXT_PUBLIC_COLORS_URL=http://localhost:3010
# Sélectionne les URL du catalogue multi-app : local, preview ou production.
# `npm run build` la lit aussi : sans elle, la garde de pré-déploiement traite le build comme
# publié et l'interrompt (voir scripts/verify-public-env.mjs).
ELSATIA_APPLICATION_ENV=local
