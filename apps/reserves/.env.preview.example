# ELSATIA Réserves — exemple Vercel Preview isolé.
# Aucun secret réel. Remplacer uniquement dans les variables Vercel du projet Preview Réserves.
# Ferme le P1 audit (ELSATIA_REAL_PREVIEW_READINESS_AUDIT_V2 §1.4, §7) : Réserves n'avait aucun
# gabarit Preview dédié, seul .env.example (gabarit de développement local).
#
# Les secrets sont ceux du SOCLE ELSATIA, jamais des doublons : la clé Brevo, l'adresse
# d'expédition et le secret de tâche planifiée sont exactement les mêmes valeurs que dans
# le déploiement Preview de Gestion Pro. Réserves partage le canal, pas une seconde configuration.

# [obligatoire] [public] — projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# NOM LEGACY, tel que LU par le code de Réserves (src/lib/supabase/server.ts et src/proxy.ts).
# La VALEUR doit être une clé publishable (sb_publishable_…), jamais une clé de service.
# Cible : NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (config/env-manifest.json, F-SUPABASE-PUBLIC-KEY-NAME).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [obligatoire] [public] — URL absolue de l'application. Sert à composer les liens
# d'invitation, qui voyagent par e-mail et doivent donc être absolus.
# ATTENTION : sans cette variable, le code retombe silencieusement sur http://localhost:3020
# (apps/reserves/src/lib/invitations.ts, apps/reserves/src/app/layout.tsx) — un oubli ici casse
# tout lien d'invitation envoyé depuis cette Preview sans faire échouer le build. Voir
# docs/runbooks/ELSATIA_SUPABASE_AUTH_PREVIEW_URLS_V1.md §5 et §3.5.
NEXT_PUBLIC_RESERVES_URL=https://<preview-host-reserves>

# [obligatoire] [serveur] — sélectionne preview ici. Lue uniquement par la garde de
# pré-déploiement (scripts/verify-public-env.mjs, npm run prebuild) : sans elle, un build est
# traité comme publié et s'interrompt avant de livrer des invitations mal formées.
ELSATIA_APPLICATION_ENV=preview

# [obligatoire si notifications] [serveur] — rôle de service. Seul le distributeur de
# notifications l'utilise : il traverse les organisations par nature, ce qu'une session
# utilisateur ne peut pas faire.
SUPABASE_SERVICE_ROLE_KEY=

# [obligatoire si e-mails] [serveur] — canal e-mail commun ELSATIA (packages/email).
# Mêmes variables que le déploiement Preview de Gestion Pro : ne pas créer de second jeu de secrets.
BREVO_API_KEY=
EMAIL_FROM_NAME=ELSATIA
EMAIL_FROM_ADDRESS=

# [obligatoire si tâches planifiées] [serveur] — authentification Bearer du cron
# /api/cron/notifications ; même secret que celui du déploiement Preview de Gestion Pro.
CRON_SECRET=
