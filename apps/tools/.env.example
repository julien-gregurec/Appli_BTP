# ELSATIA Tools — variables d'environnement (aucune valeur réelle).
# Source de vérité : config/env-manifest.json (contrôlé par scripts/check-env-manifest.mjs).
# Toutes ces variables sont PUBLIQUES (NEXT_PUBLIC_*) et figées au BUILD : les corriger après coup
# exige un nouveau build.

# [obligatoire] [public] — projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NOM LEGACY, tel que LU par le code de Tools (src/lib/auth/client.ts). La VALEUR doit être une
# clé publishable (sb_publishable_…). Cible : NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=publishable-key

# [facultative] [public] — origine publique de Tools. Repli du code : l'URL de PRODUCTION.
NEXT_PUBLIC_TOOLS_URL=http://localhost:3020
# [facultative] [public] — environnement de Tools : local|preview|production|native-dev|native-production.
# Repli du code quand absent : production.
NEXT_PUBLIC_TOOLS_ENV=local
# [si abonnement Tools] [public] — API de facturation de Gestion Pro. Aucun secret.
NEXT_PUBLIC_TOOLS_BILLING_API_URL=http://localhost:3000

# Build natif (Capacitor), facultatif :
# NEXT_PUBLIC_TOOLS_RUNTIME=native
# ELSATIA_TOOLS_NATIVE=1
