# ELSATIA Tools — exemple Vercel Preview isolé.
# Aucun secret réel. Remplacer uniquement dans les variables Vercel du projet Preview Tools.
# Ferme le P1 audit (ELSATIA_REAL_PREVIEW_READINESS_AUDIT_V2 §1.4, §7) : Tools n'avait aucun
# gabarit Preview dédié, seul .env.example (gabarit de développement local).
# Source de vérité : config/env-manifest.json (contrôlé par scripts/check-env-manifest.mjs).
# Toutes ces variables sont PUBLIQUES (NEXT_PUBLIC_*) et figées au BUILD : les corriger après coup
# exige un nouveau build Vercel Preview.

# [obligatoire] [public] — projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# [obligatoire] [public] — même projet Supabase, lue par le client « compte ELSATIA »
# authentifié (isElsatiaAccountConfigured/getElsatiaClient, src/lib/auth/client.ts).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [obligatoire en Preview] [public] — origine publique de Tools. Repli du code si absente :
# l'URL de PRODUCTION (dangereux en Preview — voir docs/runbooks/ELSATIA_SUPABASE_AUTH_PREVIEW_URLS_V1.md
# §3.4). C'est aussi l'URL exacte à enregistrer côté Supabase Auth
# (`<cette-valeur>/compte?recovery=1`, pas de route /auth/callback dédiée pour Tools).
NEXT_PUBLIC_TOOLS_URL=https://<preview-host-tools>
# [obligatoire en Preview] [public] — environnement de Tools : preview ici.
NEXT_PUBLIC_TOOLS_ENV=preview
# [si abonnement Tools] [public] — API de facturation de Gestion Pro, pointée vers le Preview GP.
NEXT_PUBLIC_TOOLS_BILLING_API_URL=https://<preview-host-gp>

# Build natif (Capacitor), facultatif — hors périmètre d'une première Preview web :
# NEXT_PUBLIC_TOOLS_RUNTIME=native
# ELSATIA_TOOLS_NATIVE=1
