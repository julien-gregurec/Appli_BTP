NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
STUDIO_STORAGE_SERVICE_KEY=
STUDIO_REDIS_URL=redis://127.0.0.1:64379
STUDIO_RENDER_TMP=/tmp/elsatia-studio-renders
STUDIO_RENDER_TIMEOUT_SECONDS=600
# Optional trusted binaries, otherwise pinned development binaries are used.
STUDIO_FFMPEG_PATH=
STUDIO_FFPROBE_PATH=

# Optional local analysis: no external API credential required. Default OFF.
STUDIO_AI_ANALYSIS=0
# Absolute path to Python with analysis/requirements.txt installed. Required when
# STUDIO_AI_ANALYSIS=1 (workers/studio-video/src/analysis-worker.ts).
STUDIO_ANALYSIS_PYTHON=
STUDIO_ANALYSIS_CONCURRENCY=1
STUDIO_ANALYSIS_TIMEOUT_SECONDS=120
