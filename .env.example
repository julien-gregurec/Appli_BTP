# ELSATIA Gestion Pro — inventaire des variables (aucune valeur réelle)
# Légende : [obligatoire|facultative] [local|preview|production] — usage ; format attendu.

# [obligatoire] [tous] — API Supabase publique ; URL HTTPS du projet.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# [obligatoire] [tous] — clé publique Supabase ; clé publishable/anon, jamais service-role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
# [obligatoire] [serveur local|preview|production] — opérations administratives et rate limit ; secret service-role.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# [obligatoire] [serveur preview|production] — HMAC des identités de rate limit ; secret aléatoire d'au moins 32 octets.
RATE_LIMIT_HMAC_KEY=random-32-byte-minimum-secret

# [obligatoire] [preview|production] — origine canonique des liens ; URL HTTPS sans chemin final.
NEXT_PUBLIC_APP_URL=https://app.example.com
# [obligatoire avant activation des e-mails] [serveur] — adresse de contact affichée aux utilisateurs ; boîte professionnelle validée.
SUPPORT_EMAIL=support-address@example.com
# [facultative] [serveur] — nom d'expéditeur des e-mails ; repli sûr vers ELSATIA.
EMAIL_FROM_NAME=ELSATIA
# [obligatoire avant activation des e-mails] [serveur] — adresse d'expédition vérifiée par le fournisseur SMTP.
EMAIL_FROM_ADDRESS=no-reply-address@example.com
# [facultative] [local] — désactive l'authentification email pour la démonstration locale uniquement ; true|false.
DISABLE_EMAIL_LOGIN=false

# [obligatoire si IA] [serveur] — API OpenAI ; clé secrète serveur.
OPENAI_API_KEY=server-only-openai-key
# [facultative] [serveur] — modèle OpenAI autorisé ; identifiant de modèle pris en charge.
OPENAI_MODEL=supported-model-id
# [facultative] [serveur] — quota métier journalier IA par entreprise ; entier positif (défaut 300).
IA_PLAFOND_QUOTIDIEN=300

# [obligatoire si paiements] [serveur] — API Stripe ; clé secrète test ou live selon l'environnement.
STRIPE_SECRET_KEY=server-only-stripe-secret
# [obligatoire si Connect] [serveur] — signature webhook Stripe Connect ; secret whsec.
STRIPE_WEBHOOK_SECRET=server-only-webhook-secret
# [obligatoire si abonnement] [serveur] — signature webhook Billing ; secret whsec distinct.
STRIPE_WEBHOOK_ABONNEMENT_SECRET=server-only-webhook-secret
# [obligatoire si boutique] [serveur] — signature webhook boutique ; secret whsec distinct.
STRIPE_WEBHOOK_BOUTIQUE_SECRET=server-only-webhook-secret
# [obligatoire si Connect] [serveur] — identifiant OAuth Stripe Connect ; identifiant ca_...
STRIPE_CONNECT_CLIENT_ID=stripe-connect-client-id
# [facultative] [serveur] — calcul automatique de taxe Stripe ; true|false.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# [obligatoires selon offres activées] [serveur] — identifiants Stripe Price, jamais des clés secrètes.
STRIPE_PRICE_ESSENTIEL_MENSUEL=price_id
STRIPE_PRICE_ESSENTIEL_ANNUEL=price_id
STRIPE_PRICE_PRO_MENSUEL=price_id
STRIPE_PRICE_PRO_ANNUEL=price_id
STRIPE_PRICE_PREMIUM_MENSUEL=price_id
STRIPE_PRICE_PREMIUM_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ESSENTIEL_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ESSENTIEL_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PRO_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PRO_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PREMIUM_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PREMIUM_ANNUEL=price_id
STRIPE_PRICE_OPTION_IA_100_MENSUEL=price_id
STRIPE_PRICE_OPTION_IA_100_ANNUEL=price_id
STRIPE_PRICE_OPTION_IA_300_MENSUEL=price_id
STRIPE_PRICE_OPTION_IA_300_ANNUEL=price_id
STRIPE_PRICE_OPTION_IA_ILLIMITE_MENSUEL=price_id
STRIPE_PRICE_OPTION_IA_ILLIMITE_ANNUEL=price_id

# [obligatoire si tâches planifiées] [serveur] — authentification Bearer des cron ; secret aléatoire >=32 octets.
CRON_SECRET=random-32-byte-minimum-secret
# [obligatoire si données bancaires] [serveur] — chiffrement AES-256 ; base64 de 32 octets, rotation contrôlée.
BANK_DATA_ENCRYPTION_KEY=base64-encoded-32-byte-key
# [obligatoire si import paie] [serveur] — dépôt expert-comptable ; secret aléatoire >=32 caractères.
PAYROLL_IMPORT_SECRET=random-32-character-minimum-secret

# [obligatoires si Powens] [serveur] — domaines contractuels HTTPS et identifiants API privés.
POWENS_API_BASE_URL=https://customer.biapi.pro/2.0
POWENS_WEBVIEW_BASE_URL=https://customer.biapi.pro/2.0/auth/webview/payment
POWENS_CLIENT_ID=powens-client-id
POWENS_CLIENT_SECRET=server-only-powens-secret

# [obligatoires si push] [serveur] — paire VAPID et identité de contact.
VAPID_PUBLIC_KEY=vapid-public-key
VAPID_PRIVATE_KEY=server-only-vapid-private-key
VAPID_SUBJECT=mailto:security@example.com
# [obligatoire si webhook notifications] [serveur] — secret partagé x-notifications-secret.
NOTIFICATIONS_WEBHOOK_SECRET=random-shared-secret

# [facultatives] [preview|production] — collecte Sentry. Le DSN public n'accorde aucun privilège.
SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
SENTRY_ORG=organization-slug
SENTRY_PROJECT=project-slug
# [facultative] [build seulement] — upload des source maps ; jeton secret jamais NEXT_PUBLIC.
SENTRY_AUTH_TOKEN=server-only-sentry-build-token

# Les variables VERCEL_* et ELSATIA_BUILD_* sont injectées automatiquement par la plateforme/build.
# Les variables LIRIA_AUDIT_* et LIRIA_LOCAL_* sont réservées aux scripts de recette locaux et
# doivent rester dans des fichiers .env ignorés, jamais dans un environnement applicatif public.
