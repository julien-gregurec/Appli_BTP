# ELSATIA Gestion Pro — inventaire des variables (aucune valeur réelle)
# Légende : [obligatoire|facultative] [local|preview|production] — usage ; format attendu.

# [obligatoire] [tous] — API Supabase publique ; URL HTTPS du projet.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# [obligatoire] [tous] — clé publique Supabase ; clé publishable (sb_publishable_...), jamais service-role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=public-publishable-key
# [obligatoire] [serveur local|preview|production] — opérations administratives et rate limit ; secret service-role.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# [obligatoire] [serveur preview|production] — HMAC des identités de rate limit ; secret aléatoire d'au moins 32 octets.
RATE_LIMIT_HMAC_KEY=random-32-byte-minimum-secret

# [obligatoire] [preview|production] — origine canonique des liens ; URL HTTPS sans chemin final.
# Production validée : https://app.elsatia.fr (application — distinct du site vitrine
# https://elsatia.fr, autre dépôt). En preview, utiliser l'origine HTTPS propre à la preview.
NEXT_PUBLIC_APP_URL=https://app.elsatia.fr
# [obligatoire] [serveur] — indicateur d'environnement canonique : local|test|preview|production.
# À poser EXPLICITEMENT sur tout déploiement (ici : production). Absent, le code retombe sur « local »
# (liens localhost) : un déploiement mal configuré se croirait local.
ELSATIA_APPLICATION_ENV=production
# [obligatoire avant activation des e-mails] [serveur] — adresse de contact affichée aux utilisateurs ; boîte professionnelle validée.
SUPPORT_EMAIL=support-address@example.com
# [facultative] [serveur] — nom d'expéditeur des e-mails ; repli sûr vers ELSATIA.
EMAIL_FROM_NAME=ELSATIA
# [obligatoire avant activation des e-mails] [serveur] — adresse d'expédition vérifiée par le fournisseur SMTP.
EMAIL_FROM_ADDRESS=no-reply-address@example.com
# [facultative] [local] — désactive l'authentification email pour la démonstration locale uniquement ; true|false.
DISABLE_EMAIL_LOGIN=false
# Démonstration locale uniquement : exige aussi une URL Supabase localhost et
# reste refusé en Production/Preview/Vercel.
ELSATIA_LOCAL_DEMO=false

# [obligatoire si IA] [serveur] — API OpenAI ; clé secrète serveur.
OPENAI_API_KEY=server-only-openai-key
# [facultative] [serveur] — modèle OpenAI autorisé ; identifiant de modèle pris en charge.
OPENAI_MODEL=supported-model-id
# [facultative] [serveur] — quota métier journalier IA par entreprise ; entier positif (défaut 300).
IA_PLAFOND_QUOTIDIEN=300

# [obligatoire si paiements] [serveur] — API Stripe ; clé secrète test ou live selon l'environnement.
STRIPE_SECRET_KEY=server-only-stripe-secret
STRIPE_STATE_ATTESTATION_KEY_ID=server-only-attestation-key-id
STRIPE_STATE_ATTESTATION_PRIVATE_KEY_B64=server-only-ed25519-pkcs8-base64
# [obligatoire si Connect] [serveur] — signature webhook Stripe Connect ; secret whsec.
STRIPE_WEBHOOK_SECRET=server-only-webhook-secret
# [obligatoire si abonnement] [serveur] — signature webhook Billing ; secret whsec distinct.
STRIPE_WEBHOOK_ABONNEMENT_SECRET=server-only-webhook-secret
# [obligatoire si boutique] [serveur] — signature webhook boutique ; secret whsec distinct.
STRIPE_WEBHOOK_BOUTIQUE_SECRET=server-only-webhook-secret
# [obligatoire si Connect] [serveur] — identifiant OAuth Stripe Connect ; identifiant ca_...
STRIPE_CONNECT_CLIENT_ID=stripe-connect-client-id
# [facultative] [serveur] — calcul automatique de taxe Stripe ; true|false.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# [obligatoires si abonnement] [serveur] — offres actuellement commercialisées.
# Utiliser exclusivement des Price IDs de test en local/preview et des Price IDs live en production.
# Ne jamais versionner de Price ID réel ni de clé Stripe réelle.
STRIPE_PRICE_MINI_MENSUEL=price_id
STRIPE_PRICE_MINI_ANNUEL=price_id
STRIPE_PRICE_PRO_MENSUEL=price_id
STRIPE_PRICE_PRO_ANNUEL=price_id
STRIPE_PRICE_BUSINESS_MENSUEL=price_id
STRIPE_PRICE_BUSINESS_ANNUEL=price_id
STRIPE_PRICE_ENTREPRISE_MENSUEL=price_id
STRIPE_PRICE_ENTREPRISE_ANNUEL=price_id
# [conditionnelles] [serveur] — comptes supplémentaires des offres actuelles.
STRIPE_PRICE_COMPTE_SUP_MINI_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_MINI_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PRO_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PRO_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_BUSINESS_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_BUSINESS_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_ANNUEL=price_id
# [héritées] [serveur] — compatibilité avec les abonnements historiques, non commercialisés actuellement.
STRIPE_PRICE_ESSENTIEL_MENSUEL=price_id
STRIPE_PRICE_ESSENTIEL_ANNUEL=price_id
STRIPE_PRICE_PREMIUM_MENSUEL=price_id
STRIPE_PRICE_PREMIUM_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ESSENTIEL_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ESSENTIEL_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PREMIUM_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_PREMIUM_ANNUEL=price_id
# [conditionnelles] [serveur] — options IA payantes, mêmes règles test/live que les offres.
STRIPE_PRICE_OPTION_IA_100_MENSUEL=price_id
STRIPE_PRICE_OPTION_IA_100_ANNUEL=price_id
STRIPE_PRICE_OPTION_IA_300_MENSUEL=price_id
STRIPE_PRICE_OPTION_IA_300_ANNUEL=price_id
STRIPE_PRICE_OPTION_IA_ILLIMITE_MENSUEL=price_id
STRIPE_PRICE_OPTION_IA_ILLIMITE_ANNUEL=price_id

# ── Generation tarifaire CANONICAL-V4-2026-09 ────────────────────────────────
# Montants : src/lib/tarification.canonical.json (source unique). Ne jamais
# recopier un montant ici. Controle par `npm run verify:stripe-prices`.
# Un nouveau contrat n'utilise QUE ces Price ; les variables des generations
# precedentes restent cablees pour honorer les abonnements deja souscrits.
# Comptes supplementaires factures PAR ROLE (les variables COMPTE_SUP_<FORFAIT>_*
# ci-dessus sont la generation precedente, non selectionnable).
STRIPE_PRICE_COMPTE_SUP_ROLE_TERRAIN_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ROLE_TERRAIN_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ROLE_CHEF_EQUIPE_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ROLE_CHEF_EQUIPE_ANNUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ROLE_ADMINISTRATIF_MENSUEL=price_id
STRIPE_PRICE_COMPTE_SUP_ROLE_ADMINISTRATIF_ANNUEL=price_id
# Expert-comptable : gratuit. AUCUNE variable, AUCUN Price Stripe.

# Modules factures a l'usage du forfait (annuel = 10 x mensuel).
STRIPE_PRICE_MODULE_POINTAGE_MENSUEL=price_id
STRIPE_PRICE_MODULE_POINTAGE_ANNUEL=price_id
STRIPE_PRICE_MODULE_STOCK_MENSUEL=price_id
STRIPE_PRICE_MODULE_STOCK_ANNUEL=price_id
STRIPE_PRICE_MODULE_MATERIEL_VEHICULES_MENSUEL=price_id
STRIPE_PRICE_MODULE_MATERIEL_VEHICULES_ANNUEL=price_id
STRIPE_PRICE_MODULE_NOTES_FRAIS_MENSUEL=price_id
STRIPE_PRICE_MODULE_NOTES_FRAIS_ANNUEL=price_id
STRIPE_PRICE_MODULE_RENTABILITE_AVANCEE_MENSUEL=price_id
STRIPE_PRICE_MODULE_RENTABILITE_AVANCEE_ANNUEL=price_id

# Intelligence artificielle : deux produits DISTINCTS, jamais fusionnes.
# Pack de credits = achat PONCTUEL (aucun tarif annuel, aucune reconduction).
STRIPE_PRICE_IA_CREDITS_PACK_PONCTUEL=price_id
# IA intensive = option RECURRENTE (mensuel / annuel).
STRIPE_PRICE_IA_INTENSIVE_MENSUEL=price_id
STRIPE_PRICE_IA_INTENSIVE_ANNUEL=price_id

# [temporaire] [serveur] — verrou de commercialisation. Laisser à false tant que
# Stripe Live, les documents juridiques et le parcours d’acceptation ne sont pas validés.
ABONNEMENTS_PUBLICS_OUVERTS=false

# [obligatoire si tâches planifiées] [serveur] — authentification Bearer des cron ; secret aléatoire >=32 octets.
CRON_SECRET=random-32-byte-minimum-secret

# ELSATIA Réserves : ses variables sont dans apps/reserves/.env.example (dont NEXT_PUBLIC_RESERVES_URL).
# Le canal e-mail (BREVO_API_KEY, EMAIL_FROM_*) et CRON_SECRET sont PARTAGÉS avec
# Gestion Pro : ne pas créer de second jeu de secrets pour Réserves.
# [obligatoire si données bancaires] [serveur] — chiffrement AES-256 ; base64 de 32 octets, rotation contrôlée.
BANK_DATA_ENCRYPTION_KEY=base64-encoded-32-byte-key
# [obligatoire si import paie] [serveur] — dépôt expert-comptable ; secret aléatoire >=32 caractères.
PAYROLL_IMPORT_SECRET=random-32-character-minimum-secret

# [obligatoires si Powens] [serveur] — domaines contractuels HTTPS et identifiants API privés.
POWENS_API_BASE_URL=https://customer.biapi.pro/2.0
POWENS_WEBVIEW_BASE_URL=https://customer.biapi.pro/2.0/auth/webview/payment
POWENS_CLIENT_ID=powens-client-id
POWENS_CLIENT_SECRET=server-only-powens-secret

# [obligatoires si push] [serveur] — paire VAPID et identité de contact.
VAPID_PUBLIC_KEY=vapid-public-key
VAPID_PRIVATE_KEY=server-only-vapid-private-key
VAPID_SUBJECT=mailto:security@example.com
# [obligatoire si webhook notifications] [serveur] — secret partagé x-notifications-secret.
NOTIFICATIONS_WEBHOOK_SECRET=random-shared-secret

# [facultatives] [preview|production] — collecte Sentry. Le DSN public n'accorde aucun privilège.
SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
SENTRY_ORG=organization-slug
SENTRY_PROJECT=project-slug
# [facultative] [build seulement] — upload des source maps ; jeton secret jamais NEXT_PUBLIC.
SENTRY_AUTH_TOKEN=server-only-sentry-build-token

# --- ELSATIA Tools : achats mobiles (App Store, Google Play) ---
# [obligatoire en production] [serveur] — environnement Store servi par ce déploiement ; sandbox|production.
# Aucune valeur par défaut en runtime de production : un repli silencieux vers sandbox ferait
# vérifier un achat réel contre le bac à sable. Absente ou inconnue en production = build/route en
# erreur explicite, par `src/lib/tools-store-environment.ts`.
TOOLS_STORE_ENVIRONMENT=sandbox
# [facultative] [serveur] — autorise un déploiement `production` à accepter des transactions de
# bac à sable ; true uniquement. Nécessaire pendant une phase TestFlight, où les testeurs achètent
# en bac à sable contre le backend de production. À retirer à la mise en vente réelle.
TOOLS_STORE_ALLOW_SANDBOX=true
# [obligatoire si achats Apple] [serveur] — certificats racine Apple pour vérifier les JWS StoreKit ;
# un ou plusieurs certificats DER encodés en base64, séparés par des virgules.
APPLE_ROOT_CA_BASE64=base64-du-certificat-racine-apple
# [obligatoire si achats Google] [serveur] — compte de service Play Developer API ; JSON complet.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# [obligatoire si notifications Google] [serveur] — audience attendue du jeton Pub/Sub des RTDN.
GOOGLE_PLAY_RTDN_AUDIENCE=https://app.elsatia.fr/api/tools/monetization/google/notifications
# [obligatoire si notifications Google] [serveur] — e-mail du compte de service émetteur des RTDN.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# [facultative] [serveur] — origines supplémentaires autorisées à appeler les routes Tools ;
# liste séparée par des virgules. Les origines Tools et Capacitor sont déjà incluses par défaut.
TOOLS_ALLOWED_ORIGINS=https://tools.elsatia.fr
# [obligatoire si abonnement Tools par Stripe] [serveur] — Stripe Tools, mode TEST uniquement :
# la route webhook refuse `livemode` et Connect. Les achats mobiles ne passent jamais par Stripe.
STRIPE_TOOLS_SECRET_KEY=sk_test_xxx
STRIPE_TOOLS_WEBHOOK_SECRET=whsec_xxx
STRIPE_TOOLS_PRICE_MONTHLY=price_xxx
STRIPE_TOOLS_PRICE_ANNUAL=price_xxx
# [obligatoire si abonnement Tools par Stripe] [serveur] — origine de retour après paiement Tools.
TOOLS_APP_URL=https://tools.elsatia.fr

# Les variables VERCEL_* et ELSATIA_BUILD_* sont injectées automatiquement par la plateforme/build.
# Les variables ELSATIA_AUDIT_* et ELSATIA_LOCAL_* sont réservées aux scripts de recette locaux et
# doivent rester dans des fichiers .env ignorés, jamais dans un environnement applicatif public.

# Price de forfait des generations precedentes encore souscrits (liste separee par des virgules).
# Repointer STRIPE_PRICE_<OFFRE>_<PERIODICITE> sans renseigner ceci rend inclassables
# les abonnements deja souscrits : le classifieur de capacite est fail-closed.
STRIPE_PRICE_BASE_GENERATIONS_PRECEDENTES=price_xxx,price_yyy

# ── Variables ajoutées d'après config/env-manifest.json (inventaire : noms seulement) ──
# Légende : [requise|facultative] [serveur|public] — usage. Aucune valeur réelle ; les secrets restent vides.
# [facultative] [serveur] — Sous-drapeau de FEATURE_AI_ENABLED : génération assistée de devis (rollback isolé).
FEATURE_AI_DEVIS_ENABLED=false
# [facultative] [serveur] — Active l'assistant IA.
FEATURE_AI_ENABLED=false
# [facultative] [serveur] — Ouvre la Boutique (catalogue, panier, paiement, webhook).
FEATURE_BOUTIQUE_ENABLED=false
# [facultative] [serveur] — Active les tâches planifiées historiques (abonnements, alertes, paie, pointage).
FEATURE_CRONS_ENABLED=true
# [facultative] [serveur] — Envoi AUTOMATIQUE des relances de factures (cron).
FEATURE_RELANCES_AUTO_ENABLED=false
# [requise] [serveur] — Mode Stripe attendu par les webhooks d'abonnement : test | live.
STRIPE_WEBHOOK_EXPECTED_MODE=test
# [facultative dès que la facturation Tools est ouverte] [serveur] — Price ID Stripe de l'abonnement Tools annuel.
STRIPE_TOOLS_PRICE_ANNUAL=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Price ID Stripe de l'abonnement Tools mensuel.
STRIPE_TOOLS_PRICE_MONTHLY=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Clé secrète Stripe dédiée à la facturation de Tools.
STRIPE_TOOLS_SECRET_KEY=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Secret de signature du webhook Stripe de Tools.
STRIPE_TOOLS_WEBHOOK_SECRET=
# [facultative dès que l'envoi d'e-mails est activé] [serveur] — Clé API du canal e-mail commun ELSATIA (Brevo) : invitations, réinitialisations, relances.
BREVO_API_KEY=
# [facultative dès que les achats iOS Tools sont ouverts] [serveur] — Certificat racine Apple (public) pour valider les achats iOS de Tools.
APPLE_ROOT_CA_BASE64=
# [facultative dès que les achats Android Tools sont ouverts] [serveur] — Audience attendue des notifications Google Play RTDN.
GOOGLE_PLAY_RTDN_AUDIENCE=
# [facultative dès que les achats Android Tools sont ouverts] [serveur] — E-mail du compte de service émetteur des notifications RTDN.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
# [facultative dès que les achats Android Tools sont ouverts] [serveur] — Compte de service Google Play (JSON contenant une clé privée) pour valider les achats Android de Tools.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# [requise] [public] — SIRET de l'éditeur affiché dans les mentions légales (public).
NEXT_PUBLIC_LEGAL_SIRET=
# [requise] [public] — N° de TVA intracommunautaire affiché dans les mentions légales (public).
NEXT_PUBLIC_LEGAL_TVA=
# [requise] [public] — Origine publique de Colors : metadataBase et redirectTo de la réinitialisation de mot de passe.
NEXT_PUBLIC_COLORS_URL=
# [facultative dès que Tools appelle l'API de facturation] [serveur] — Liste blanche CORS (séparée par des virgules) des origines autorisées à appeler l'API de facturation.
TOOLS_ALLOWED_ORIGINS=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Origine de Tools utilisée par Gestion Pro pour composer les URL de retour Stripe Checkout de Tools.
TOOLS_APP_URL=
