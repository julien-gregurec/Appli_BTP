-- =====================================================================================================
-- PROPOSITION — NON APPLIQUÉE, NON NUMÉROTÉE, HORS supabase/migrations
-- Lot : ELSATIA-GP-V1-METIER — A-bis « références internes »
-- Branche : feat/gp-v1-metier-devis-planning-references-v1
-- =====================================================================================================
--
-- PRÉREQUIS : gp-devis-wysiwyg-catalogue-ouvrages-v1.sql.proposed appliquée AVANT ce fichier (elle crée
-- `normaliser_reference`, `ouvrages` et les colonnes de références du catalogue). Le bloc 0 le vérifie.
-- Ledger constaté le 2026-09-11 : n° max 281 (Colors, non fusionné). AUCUN numéro réservé.
-- Pour intégrer : copier ce fichier, SANS le modifier, sous le numéro que l'audit global du ledger
-- attribuera, juste APRÈS celui de la proposition devis v2. Aucune migration existante n'est modifiée :
-- les fonctions étendues sont REDÉFINIES (create or replace). Rejouable (if not exists, gardes).
--
-- Décisions de Julien appliquées (2026-09-11) :
--   D3  « référence fournisseur » = référence du FABRICANT (colonne `reference_fabricant`, déjà prévue) ;
--       « code article fournisseur » = code de l'article chez le DISTRIBUTEUR, un par fournisseur
--       (table `catalogue_codes_fournisseurs`, sans aucun prix).
--   Référence interne UNIQUE par entreprise et par nature d'objet, sur la forme normalisée : ceci
--   REMPLACE le choix « aucune unicité » de la proposition devis v2 pour `reference_interne` (la
--   référence fabricant, elle, reste non unique : teintes, conditionnements).
--
-- Contenu :
--   1. paramètres des références par entreprise (préfixe, largeur, année, génération automatique)
--   2. générateur sûr : n'attribue jamais une valeur déjà saisie à la main (défaut A5 du lot A)
--   3. déclencheurs de normalisation (vide → NULL, espaces retirés) et d'attribution
--   4. reprise : `articles_stock.reference_interne` initialisée depuis `reference` quand elle est libre
--   5. références d'affaire et client sur devis, factures, commandes fournisseurs
--   6. codes articles des distributeurs (D3)
--   7. historique des objets (ajout seul) et journal des changements de référence
--   8. doublons signalés (toutes sources) puis unicité normalisée, refusée s'il reste des doublons
--   9. attribution des références manquantes à la demande
--  10. RLS et droits
--
-- Défaut connu NON traité ici : `a_permission` accorde toutes les clés à une session support côté SQL
-- (20260718000110) — lot sécurité dédié.
-- =====================================================================================================


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 0. Prérequis et outils de session
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
do $$
begin
  if to_regprocedure('public.normaliser_reference(text)') is null
     or to_regclass('public.ouvrages') is null
     or not exists (select 1 from information_schema.columns
                     where table_schema = 'public' and table_name = 'prestations_catalogue'
                       and column_name = 'reference_interne') then
    raise exception 'Prérequis absent : appliquer d''abord gp-devis-wysiwyg-catalogue-ouvrages-v1'
      using errcode = '55000';
  end if;
end $$;

create or replace function pg_temp.ajouter_contrainte(p_table regclass, p_nom text, p_definition text)
returns void language plpgsql as $$
begin
  if not exists (select 1 from pg_constraint where conrelid = p_table and conname = p_nom) then
    execute format('alter table %s add constraint %I %s', p_table, p_nom, p_definition);
  end if;
end $$;

create or replace function pg_temp.assurer_unicite_id_entreprise(p_table regclass, p_nom text)
returns void language plpgsql as $$
begin
  if not exists (
    select 1
    from pg_index i
    where i.indrelid = p_table and i.indisunique and i.indpred is null
      and (select array_agg(a.attname::text order by a.attname)
             from unnest(i.indkey) k join pg_attribute a on a.attrelid = p_table and a.attnum = k)
          = array['entreprise_id', 'id']
  ) then
    execute format('create unique index %I on %s (id, entreprise_id)', p_nom, p_table);
  end if;
end $$;


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 1. Paramètres des références par entreprise
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Valeurs par défaut = comportement historique (CLI-0001, CHA-AAAA-001, FRN-0001) + ART et OUV nouveaux.
-- Changer de préfixe ne remet pas le compteur à zéro : le compteur est lié à la nature d'objet.
create or replace function public.reference_parametre_defaut(p_entite text)
returns table (prefixe text, largeur integer, avec_annee boolean, compteur text)
language sql immutable parallel safe as $$
  select d.prefixe, d.largeur, d.avec_annee, d.compteur
  from (values
    ('client',      'CLI', 4, false, 'client'),
    ('chantier',    'CHA', 3, true,  'chantier'),
    ('fournisseur', 'FRN', 4, false, 'fournisseur'),
    ('article',     'ART', 5, false, 'reference_article'),
    ('ouvrage',     'OUV', 4, false, 'reference_ouvrage')
  ) d(entite, prefixe, largeur, avec_annee, compteur)
  where d.entite = p_entite
$$;

create table if not exists public.references_parametres (
  entreprise_id   uuid not null references public.entreprises (id) on delete cascade,
  entite          text not null check (entite in ('client', 'chantier', 'fournisseur', 'article', 'ouvrage')),
  prefixe         text not null check (prefixe ~ '^[A-Z0-9]{1,8}$'),
  largeur         integer not null default 4 check (largeur between 3 and 8),
  avec_annee      boolean not null default false,
  generation_auto boolean not null default true,
  maj_le          timestamptz not null default now(),
  maj_par         uuid default auth.uid(),
  primary key (entreprise_id, entite)
);

comment on table public.references_parametres is
  'Format des références internes générées, par entreprise et par nature d''objet. Absent = valeurs par défaut.';

-- Génération automatique active ? Le fournisseur est toujours généré (colonne obligatoire).
create or replace function public.reference_generation_auto(p_entreprise_id uuid, p_entite text)
returns boolean
language sql stable security definer set search_path = public as $$
  select p_entite = 'fournisseur'
      or coalesce((select rp.generation_auto from public.references_parametres rp
                    where rp.entreprise_id = p_entreprise_id and rp.entite = p_entite), true)
$$;


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 2. Générateur sûr
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- `next_reference` incrémente un compteur sans regarder les valeurs saisies à la main : après une saisie
-- manuelle de « CLI-0007 », la septième génération heurtait l'unicité. On avance tant que la valeur
-- produite existe déjà (comparée sous forme normalisée, comme l'unicité). Borne de 1 000 essais.
create or replace function public.generer_reference_interne(p_entreprise_id uuid, p_entite text)
returns text
language plpgsql
security definer
set search_path = public
as $$
declare
  v_defaut  record;
  v_prefixe text;
  v_largeur integer;
  v_annee   boolean;
  v_table   regclass;
  v_colonne text;
  v_ref     text;
  v_existe  boolean;
begin
  select * into v_defaut from public.reference_parametre_defaut(p_entite);
  if not found then
    raise exception 'Nature d''objet sans référence générée : %', p_entite using errcode = '22023';
  end if;

  select coalesce(rp.prefixe, v_defaut.prefixe), coalesce(rp.largeur, v_defaut.largeur),
         coalesce(rp.avec_annee, v_defaut.avec_annee)
    into v_prefixe, v_largeur, v_annee
    from (select 1) x
    left join public.references_parametres rp on rp.entreprise_id = p_entreprise_id and rp.entite = p_entite;

  v_table := case p_entite
    when 'client' then 'public.clients'::regclass
    when 'chantier' then 'public.chantiers'::regclass
    when 'fournisseur' then 'public.fournisseurs'::regclass
    when 'article' then 'public.prestations_catalogue'::regclass
    when 'ouvrage' then 'public.ouvrages'::regclass
  end;
  v_colonne := case p_entite when 'fournisseur' then 'reference' else 'reference_interne' end;

  for i in 1 .. 1000 loop
    v_ref := public.next_reference(p_entreprise_id, v_defaut.compteur, v_prefixe, v_largeur, v_annee);
    execute format(
      'select exists (select 1 from %s where entreprise_id = $1 and public.normaliser_reference(%I) = public.normaliser_reference($2))',
      v_table, v_colonne)
      into v_existe using p_entreprise_id, v_ref;
    if not v_existe then
      return v_ref;
    end if;
  end loop;
  raise exception 'Aucune référence libre après 1 000 essais pour % (préfixe %)', p_entite, v_prefixe
    using errcode = '23505';
end $$;

revoke all on function public.generer_reference_interne(uuid, text) from public, anon, authenticated, service_role;


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 3. Déclencheurs de normalisation et d'attribution
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Générateurs historiques redéfinis (définitions d'origine : 20260710000004 et 20260710000021) : même
-- format par défaut, mais valeur vide = absente, format paramétrable et valeur jamais déjà prise.
create or replace function public.trg_ref_client()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  new.reference_interne := nullif(btrim(new.reference_interne), '');
  if new.reference_interne is null and public.reference_generation_auto(new.entreprise_id, 'client') then
    new.reference_interne := public.generer_reference_interne(new.entreprise_id, 'client');
  end if;
  return new;
end $$;

create or replace function public.trg_ref_chantier()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  new.reference_interne := nullif(btrim(new.reference_interne), '');
  if new.reference_interne is null and public.reference_generation_auto(new.entreprise_id, 'chantier') then
    new.reference_interne := public.generer_reference_interne(new.entreprise_id, 'chantier');
  end if;
  return new;
end $$;

create or replace function public.trg_fournisseur_reference()
returns trigger language plpgsql security definer set search_path = public as $$
begin
  new.reference := nullif(btrim(new.reference), '');
  if new.reference is null then
    new.reference := public.generer_reference_interne(new.entreprise_id, 'fournisseur');
  end if;
  return new;
end $$;

-- Déclencheur générique : arguments = nature d'objet à générer ('' = aucune génération), puis les
-- colonnes de référence à normaliser (espaces retirés en tête et en fin, vide → NULL).
-- Nature 'stock' : à la création, la référence interne reprend `reference` (code article du stock) si
-- aucune autre fiche de l'entreprise ne la porte déjà ; sinon elle reste vide et le doublon est signalé.
create or replace function public.trg_references_normalisees()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  v_entite text := tg_argv[0];
  v_patch  jsonb := '{}'::jsonb;
  v_col    text;
  v_val    text;
  v_ref    text;
begin
  for i in 1 .. tg_nargs - 1 loop
    v_col := tg_argv[i];
    v_val := to_jsonb(new) ->> v_col;
    if v_val is not null and v_val is distinct from nullif(btrim(v_val), '') then
      v_patch := v_patch || jsonb_build_object(v_col, nullif(btrim(v_val), ''));
    end if;
  end loop;
  if v_patch <> '{}'::jsonb then
    new := jsonb_populate_record(new, v_patch);
  end if;

  if tg_op = 'INSERT' and v_entite <> '' and (to_jsonb(new) ->> 'reference_interne') is null then
    if v_entite = 'stock' then
      v_ref := nullif(btrim(to_jsonb(new) ->> 'reference'), '');
      if v_ref is not null and not exists (
        select 1 from public.articles_stock a
        where a.entreprise_id = new.entreprise_id
          and public.normaliser_reference(a.reference_interne) = public.normaliser_reference(v_ref)
      ) then
        new := jsonb_populate_record(new, jsonb_build_object('reference_interne', v_ref));
      end if;
    elsif public.reference_generation_auto(new.entreprise_id, v_entite) then
      new := jsonb_populate_record(new, jsonb_build_object(
        'reference_interne', public.generer_reference_interne(new.entreprise_id, v_entite)));
    end if;
  end if;
  return new;
end $$;

drop trigger if exists gp_references_normalisees on public.prestations_catalogue;
create trigger gp_references_normalisees
  before insert or update of reference_interne, reference_fabricant, code_barres on public.prestations_catalogue
  for each row execute function public.trg_references_normalisees('article', 'reference_interne', 'reference_fabricant', 'code_barres');

drop trigger if exists gp_references_normalisees on public.ouvrages;
create trigger gp_references_normalisees
  before insert or update of reference_interne on public.ouvrages
  for each row execute function public.trg_references_normalisees('ouvrage', 'reference_interne');

-- Nommé en « a_… » : doit passer avant `verifier_droit_prix_stock` (ordre alphabétique), qui ne regarde
-- que les prix et n'est pas affecté.
drop trigger if exists a_gp_references_normalisees on public.articles_stock;
create trigger a_gp_references_normalisees
  before insert or update of reference_interne, reference_fabricant on public.articles_stock
  for each row execute function public.trg_references_normalisees('stock', 'reference_interne', 'reference_fabricant');

-- Clients et chantiers : l'attribution reste faite par les générateurs historiques à la création ;
-- seule la normalisation s'ajoute à la modification.
drop trigger if exists gp_references_normalisees on public.clients;
create trigger gp_references_normalisees
  before update of reference_interne on public.clients
  for each row execute function public.trg_references_normalisees('', 'reference_interne');

drop trigger if exists gp_references_normalisees on public.chantiers;
create trigger gp_references_normalisees
  before update of reference_interne on public.chantiers
  for each row execute function public.trg_references_normalisees('', 'reference_interne');


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 4. Reprise : articles du stock
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- `reference` est unique au caractère près ; deux codes qui ne diffèrent que par la casse ou un tiret
-- (« AB-12 », « ab12 ») sont LAISSÉS sans référence interne et signalés par les doublons : jamais de
-- choix arbitraire. Le journal n'est posé qu'après cette reprise (bloc 7) : pas de bruit.
with candidats as (
  select a.id, a.entreprise_id, public.normaliser_reference(a.reference) as n
  from public.articles_stock a
  where a.reference_interne is null and btrim(a.reference) <> ''
),
libres as (
  select c.id
  from candidats c
  where not exists (
    select 1 from public.articles_stock b
    where b.entreprise_id = c.entreprise_id and b.id <> c.id
      and public.normaliser_reference(coalesce(b.reference_interne, b.reference)) = c.n
  )
)
update public.articles_stock a
   set reference_interne = btrim(a.reference)
  from libres l
 where a.id = l.id;


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 5. Références d'affaire et client sur les documents
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Le numéro légal (`numero`) reste LA référence du document : immuable, chronologique, attribué à
-- l'émission. S'ajoutent, non uniques (plusieurs devis pour une même affaire) :
--   reference_interne     = référence d'affaire / de dossier dans l'entreprise ;
--   reference_client      = référence du bon de commande ou du dossier chez le client (imprimée) ;
--   reference_fournisseur = pour une commande, référence de l'offre ou de l'accusé du fournisseur.
-- Leur recopie devis → facture est ajoutée avec la refonte des transformations (lot D).
alter table public.devis
  add column if not exists reference_interne text,
  add column if not exists reference_client  text;
alter table public.factures
  add column if not exists reference_interne text,
  add column if not exists reference_client  text;
alter table public.commandes_fournisseurs
  add column if not exists reference_interne     text,
  add column if not exists reference_fournisseur text;

select pg_temp.ajouter_contrainte('public.devis', 'devis_references_longueur_check',
  'check (coalesce(length(reference_interne), 0) <= 120 and coalesce(length(reference_client), 0) <= 120)');
select pg_temp.ajouter_contrainte('public.factures', 'factures_references_longueur_check',
  'check (coalesce(length(reference_interne), 0) <= 120 and coalesce(length(reference_client), 0) <= 120)');
select pg_temp.ajouter_contrainte('public.commandes_fournisseurs', 'commandes_fournisseurs_references_longueur_check',
  'check (coalesce(length(reference_interne), 0) <= 120 and coalesce(length(reference_fournisseur), 0) <= 120)');

create index if not exists devis_reference_interne_norm_idx
  on public.devis (entreprise_id, public.normaliser_reference(reference_interne) text_pattern_ops);
create index if not exists devis_reference_client_norm_idx
  on public.devis (entreprise_id, public.normaliser_reference(reference_client) text_pattern_ops);
create index if not exists factures_reference_interne_norm_idx
  on public.factures (entreprise_id, public.normaliser_reference(reference_interne) text_pattern_ops);
create index if not exists factures_reference_client_norm_idx
  on public.factures (entreprise_id, public.normaliser_reference(reference_client) text_pattern_ops);
create index if not exists commandes_fournisseurs_reference_interne_norm_idx
  on public.commandes_fournisseurs (entreprise_id, public.normaliser_reference(reference_interne) text_pattern_ops);

drop trigger if exists gp_references_normalisees on public.devis;
create trigger gp_references_normalisees
  before insert or update of reference_interne, reference_client on public.devis
  for each row execute function public.trg_references_normalisees('', 'reference_interne', 'reference_client');
drop trigger if exists gp_references_normalisees on public.factures;
create trigger gp_references_normalisees
  before insert or update of reference_interne, reference_client on public.factures
  for each row execute function public.trg_references_normalisees('', 'reference_interne', 'reference_client');
drop trigger if exists gp_references_normalisees on public.commandes_fournisseurs;
create trigger gp_references_normalisees
  before insert or update of reference_interne, reference_fournisseur on public.commandes_fournisseurs
  for each row execute function public.trg_references_normalisees('', 'reference_interne', 'reference_fournisseur');


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 6. Codes articles des distributeurs (D3)
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Un article (du catalogue des devis OU du stock) peut s'acheter chez plusieurs distributeurs, chacun
-- avec son propre code. AUCUN prix ici : les prix d'achat vivent dans les tables de coûts protégées
-- (prestations_catalogue_couts) ou dans les tarifs fournisseurs (acces_connecteurs).
select pg_temp.assurer_unicite_id_entreprise('public.articles_stock', 'articles_stock_id_entreprise_unique');
select pg_temp.assurer_unicite_id_entreprise('public.prestations_catalogue', 'prestations_catalogue_id_entreprise_unique');
select pg_temp.assurer_unicite_id_entreprise('public.fournisseurs', 'fournisseurs_id_entreprise_unique');

create table if not exists public.catalogue_codes_fournisseurs (
  id               uuid primary key default gen_random_uuid(),
  entreprise_id    uuid not null references public.entreprises (id) on delete cascade,
  prestation_id    uuid,
  article_stock_id uuid,
  fournisseur_id   uuid not null,
  code_article     text not null check (length(btrim(code_article)) between 1 and 120),
  principal        boolean not null default false,
  cree_par         uuid default auth.uid(),
  cree_le          timestamptz not null default now(),
  modifie_le       timestamptz not null default now(),
  check (num_nonnulls(prestation_id, article_stock_id) = 1),
  foreign key (prestation_id, entreprise_id) references public.prestations_catalogue (id, entreprise_id) on delete cascade,
  foreign key (article_stock_id, entreprise_id) references public.articles_stock (id, entreprise_id) on delete cascade,
  foreign key (fournisseur_id, entreprise_id) references public.fournisseurs (id, entreprise_id) on delete restrict
);

create unique index if not exists catalogue_codes_fournisseurs_prestation_uniq
  on public.catalogue_codes_fournisseurs (prestation_id, fournisseur_id) where prestation_id is not null;
create unique index if not exists catalogue_codes_fournisseurs_article_uniq
  on public.catalogue_codes_fournisseurs (article_stock_id, fournisseur_id) where article_stock_id is not null;
create unique index if not exists catalogue_codes_fournisseurs_prestation_principal_uniq
  on public.catalogue_codes_fournisseurs (prestation_id) where prestation_id is not null and principal;
create unique index if not exists catalogue_codes_fournisseurs_article_principal_uniq
  on public.catalogue_codes_fournisseurs (article_stock_id) where article_stock_id is not null and principal;
create index if not exists catalogue_codes_fournisseurs_code_norm_idx
  on public.catalogue_codes_fournisseurs (entreprise_id, public.normaliser_reference(code_article) text_pattern_ops);
create index if not exists catalogue_codes_fournisseurs_fournisseur_idx
  on public.catalogue_codes_fournisseurs (fournisseur_id);

drop trigger if exists catalogue_codes_fournisseurs_modifie_le on public.catalogue_codes_fournisseurs;
create or replace function public.trg_codes_fournisseurs_modifie_le()
returns trigger language plpgsql set search_path = public as $$
begin
  new.code_article := btrim(new.code_article);
  new.modifie_le := now();
  return new;
end $$;
create trigger catalogue_codes_fournisseurs_modifie_le
  before insert or update on public.catalogue_codes_fournisseurs
  for each row execute function public.trg_codes_fournisseurs_modifie_le();


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 7. Historique des objets (ajout seul)
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Socle commun à tous les lots V1 (références ici ; statuts, prix, envois, planning ensuite). Écrit
-- UNIQUEMENT par des fonctions SECURITY DEFINER : aucun droit d'écriture direct, un historique ne se
-- falsifie pas depuis le navigateur. Lecture = droit d'accès au module de l'objet ; une entrée
-- `sensible` (coût, marge) exige en plus `voir_couts_devis`.
create table if not exists public.historique_objets (
  id             bigint generated always as identity primary key,
  entreprise_id  uuid not null references public.entreprises (id) on delete cascade,
  ressource      text not null check (ressource in (
                   'client', 'chantier', 'fournisseur', 'article', 'article_stock', 'ouvrage',
                   'devis', 'facture', 'commande', 'planning')),
  ressource_id   uuid not null,
  action         text not null check (action ~ '^[a-z_]{2,60}$'),
  champ          text check (champ is null or champ ~ '^[a-z_]{1,60}$'),
  avant          jsonb,
  apres          jsonb,
  sensible       boolean not null default false,
  utilisateur_id uuid references auth.users (id) on delete set null default auth.uid(),
  cree_le        timestamptz not null default now()
);

create index if not exists historique_objets_objet_idx
  on public.historique_objets (entreprise_id, ressource, ressource_id, cree_le desc);
create index if not exists historique_objets_utilisateur_idx
  on public.historique_objets (entreprise_id, utilisateur_id, cree_le desc);

create or replace function public.permissions_lecture_historique(p_ressource text)
returns text[] language sql immutable parallel safe as $$
  select case p_ressource
    when 'client'        then array['acces_clients']
    when 'chantier'      then array['acces_chantiers']
    when 'fournisseur'   then array['acces_achats']
    when 'commande'      then array['acces_achats']
    when 'article'       then array['acces_devis', 'acces_ouvrages']
    when 'article_stock' then array['acces_stock']
    when 'ouvrage'       then array['acces_ouvrages', 'acces_devis']
    when 'devis'         then array['acces_devis']
    when 'facture'       then array['acces_factures']
    when 'planning'      then array['acces_planning']
    else array[]::text[]
  end
$$;

create or replace function public.journaliser_objet(
  p_entreprise_id uuid, p_ressource text, p_ressource_id uuid, p_action text,
  p_champ text default null, p_avant jsonb default null, p_apres jsonb default null, p_sensible boolean default false
)
returns void language sql security definer set search_path = public as $$
  insert into public.historique_objets (entreprise_id, ressource, ressource_id, action, champ, avant, apres, sensible)
  values (p_entreprise_id, p_ressource, p_ressource_id, p_action, p_champ, p_avant, p_apres, coalesce(p_sensible, false))
$$;

revoke all on function public.journaliser_objet(uuid, text, uuid, text, text, jsonb, jsonb, boolean)
  from public, anon, authenticated, service_role;

-- Changement de référence : arguments = ressource, puis colonnes suivies. Seules les MODIFICATIONS sont
-- journalisées (la création relève du journal de création des lots suivants).
create or replace function public.trg_historique_references()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  v_col   text;
  v_avant text;
  v_apres text;
begin
  for i in 1 .. tg_nargs - 1 loop
    v_col := tg_argv[i];
    v_avant := to_jsonb(old) ->> v_col;
    v_apres := to_jsonb(new) ->> v_col;
    if v_avant is distinct from v_apres then
      perform public.journaliser_objet(
        new.entreprise_id, tg_argv[0], new.id,
        case when v_avant is null then 'reference_attribuee'
             when v_apres is null then 'reference_retiree'
             else 'reference_modifiee' end,
        v_col, to_jsonb(v_avant), to_jsonb(v_apres), false);
    end if;
  end loop;
  return null;
end $$;

drop trigger if exists gp_historique_references on public.clients;
create trigger gp_historique_references after update of reference_interne on public.clients
  for each row execute function public.trg_historique_references('client', 'reference_interne');
drop trigger if exists gp_historique_references on public.chantiers;
create trigger gp_historique_references after update of reference_interne on public.chantiers
  for each row execute function public.trg_historique_references('chantier', 'reference_interne');
drop trigger if exists gp_historique_references on public.fournisseurs;
create trigger gp_historique_references after update of reference on public.fournisseurs
  for each row execute function public.trg_historique_references('fournisseur', 'reference');
drop trigger if exists gp_historique_references on public.prestations_catalogue;
create trigger gp_historique_references after update of reference_interne, reference_fabricant, code_barres on public.prestations_catalogue
  for each row execute function public.trg_historique_references('article', 'reference_interne', 'reference_fabricant', 'code_barres');
drop trigger if exists gp_historique_references on public.articles_stock;
create trigger gp_historique_references after update of reference, reference_interne, reference_fabricant, code_barres on public.articles_stock
  for each row execute function public.trg_historique_references('article_stock', 'reference', 'reference_interne', 'reference_fabricant', 'code_barres');
drop trigger if exists gp_historique_references on public.ouvrages;
create trigger gp_historique_references after update of reference_interne on public.ouvrages
  for each row execute function public.trg_historique_references('ouvrage', 'reference_interne');
drop trigger if exists gp_historique_references on public.devis;
create trigger gp_historique_references after update of reference_interne, reference_client on public.devis
  for each row execute function public.trg_historique_references('devis', 'reference_interne', 'reference_client');
drop trigger if exists gp_historique_references on public.factures;
create trigger gp_historique_references after update of reference_interne, reference_client on public.factures
  for each row execute function public.trg_historique_references('facture', 'reference_interne', 'reference_client');
drop trigger if exists gp_historique_references on public.commandes_fournisseurs;
create trigger gp_historique_references after update of reference_interne, reference_fournisseur on public.commandes_fournisseurs
  for each row execute function public.trg_historique_references('commande', 'reference_interne', 'reference_fournisseur');

-- Codes distributeurs : journalisés sur l'ARTICLE (c'est son historique que l'on consulte).
create or replace function public.trg_historique_codes_fournisseurs()
returns trigger language plpgsql security definer set search_path = public as $$
declare
  v_ligne public.catalogue_codes_fournisseurs := coalesce(new, old);
  v_ressource text := case when v_ligne.prestation_id is not null then 'article' else 'article_stock' end;
  v_objet uuid := coalesce(v_ligne.prestation_id, v_ligne.article_stock_id);
begin
  if tg_op = 'UPDATE' and old.code_article is not distinct from new.code_article
     and old.fournisseur_id is not distinct from new.fournisseur_id then
    return null;
  end if;
  perform public.journaliser_objet(
    v_ligne.entreprise_id, v_ressource, v_objet,
    case tg_op when 'INSERT' then 'code_fournisseur_ajoute' when 'DELETE' then 'code_fournisseur_retire'
               else 'code_fournisseur_modifie' end,
    'code_article_fournisseur',
    case when tg_op <> 'INSERT' then jsonb_build_object('fournisseur_id', old.fournisseur_id, 'code', old.code_article) end,
    case when tg_op <> 'DELETE' then jsonb_build_object('fournisseur_id', new.fournisseur_id, 'code', new.code_article) end,
    false);
  return null;
end $$;

drop trigger if exists gp_historique_codes on public.catalogue_codes_fournisseurs;
create trigger gp_historique_codes after insert or update or delete on public.catalogue_codes_fournisseurs
  for each row execute function public.trg_historique_codes_fournisseurs();


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 8. Doublons signalés, puis unicité normalisée
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Redéfinition (même signature, mêmes colonnes) de la fonction de la proposition devis v2 : elle couvre
-- désormais toutes les sources du catalogue, les ouvrages, les codes distributeurs et les collisions
-- ENTRE catalogue des devis et stock. SECURITY INVOKER : chacun ne voit que ce que la RLS lui montre.
create or replace function public.doublons_references_catalogue(p_entreprise_id uuid)
returns table (source text, champ text, reference_normalisee text, identifiants uuid[])
language sql stable security invoker set search_path = public as $$
  select 'prestation', 'reference_interne', public.normaliser_reference(reference_interne), array_agg(id order by id)
    from public.prestations_catalogue
   where entreprise_id = p_entreprise_id and coalesce(reference_interne, '') <> ''
   group by public.normaliser_reference(reference_interne) having count(*) > 1
  union all
  select 'prestation', 'reference_fabricant', public.normaliser_reference(reference_fabricant), array_agg(id order by id)
    from public.prestations_catalogue
   where entreprise_id = p_entreprise_id and coalesce(reference_fabricant, '') <> ''
   group by public.normaliser_reference(reference_fabricant) having count(*) > 1
  union all
  select 'article', 'reference_interne', public.normaliser_reference(coalesce(reference_interne, reference)), array_agg(id order by id)
    from public.articles_stock
   where entreprise_id = p_entreprise_id and coalesce(reference_interne, reference, '') <> ''
   group by public.normaliser_reference(coalesce(reference_interne, reference)) having count(*) > 1
  union all
  select 'article', 'reference_fabricant', public.normaliser_reference(reference_fabricant), array_agg(id order by id)
    from public.articles_stock
   where entreprise_id = p_entreprise_id and coalesce(reference_fabricant, '') <> ''
   group by public.normaliser_reference(reference_fabricant) having count(*) > 1
  union all
  select 'ouvrage', 'reference_interne', public.normaliser_reference(reference_interne), array_agg(id order by id)
    from public.ouvrages
   where entreprise_id = p_entreprise_id and coalesce(reference_interne, '') <> ''
   group by public.normaliser_reference(reference_interne) having count(*) > 1
  union all
  select 'prestation+article', 'reference_interne', p.n, array[p.id, a.id]
    from (select id, public.normaliser_reference(reference_interne) n from public.prestations_catalogue
           where entreprise_id = p_entreprise_id and coalesce(reference_interne, '') <> '') p
    join (select id, public.normaliser_reference(reference_interne) n from public.articles_stock
           where entreprise_id = p_entreprise_id and coalesce(reference_interne, '') <> '') a on a.n = p.n
  union all
  select 'code_fournisseur', 'code_article', public.normaliser_reference(code_article), array_agg(coalesce(prestation_id, article_stock_id) order by id)
    from public.catalogue_codes_fournisseurs
   where entreprise_id = p_entreprise_id
   group by fournisseur_id, public.normaliser_reference(code_article) having count(*) > 1
$$;

create or replace function public.doublons_references(p_entreprise_id uuid)
returns table (source text, champ text, reference_normalisee text, identifiants uuid[])
language sql stable security invoker set search_path = public as $$
  select * from public.doublons_references_catalogue(p_entreprise_id)
  union all
  select 'client', 'reference_interne', public.normaliser_reference(reference_interne), array_agg(id order by id)
    from public.clients
   where entreprise_id = p_entreprise_id and coalesce(reference_interne, '') <> ''
   group by public.normaliser_reference(reference_interne) having count(*) > 1
  union all
  select 'chantier', 'reference_interne', public.normaliser_reference(reference_interne), array_agg(id order by id)
    from public.chantiers
   where entreprise_id = p_entreprise_id and coalesce(reference_interne, '') <> ''
   group by public.normaliser_reference(reference_interne) having count(*) > 1
  union all
  select 'fournisseur', 'reference', public.normaliser_reference(reference), array_agg(id order by id)
    from public.fournisseurs
   where entreprise_id = p_entreprise_id and coalesce(reference, '') <> ''
   group by public.normaliser_reference(reference) having count(*) > 1
$$;

-- Unicité par entreprise sur la forme normalisée. S'il reste des doublons (données saisies entre
-- l'application de la proposition devis v2 et celle-ci, ou tiers historiques ne différant que par la
-- casse), la migration S'ARRÊTE en les comptant : mieux vaut un échec explicite qu'une unicité
-- silencieusement absente. Requête de contrôle préalable, en lecture seule, dans le rapport du lot.
create or replace function pg_temp.creer_unicite_reference(p_table regclass, p_colonne text, p_index text)
returns void language plpgsql as $$
declare
  v_doublons integer;
begin
  if to_regclass('public.' || p_index) is not null then
    return;
  end if;
  execute format(
    'select count(*) from (select 1 from %s where %I is not null and btrim(%I) <> '''' '
    'group by entreprise_id, public.normaliser_reference(%I) having count(*) > 1) d',
    p_table, p_colonne, p_colonne, p_colonne) into v_doublons;
  if v_doublons > 0 then
    raise exception 'Unicité impossible sur %.% : % valeur(s) en double sous forme normalisée', p_table, p_colonne, v_doublons
      using errcode = '23505',
            hint = 'Lister avec public.doublons_references(entreprise_id), corriger, puis rejouer ce fichier.';
  end if;
  execute format(
    'create unique index %I on %s (entreprise_id, public.normaliser_reference(%I)) where %I is not null and btrim(%I) <> ''''',
    p_index, p_table, p_colonne, p_colonne, p_colonne);
end $$;

select pg_temp.creer_unicite_reference('public.clients', 'reference_interne', 'clients_reference_interne_norm_uniq');
select pg_temp.creer_unicite_reference('public.chantiers', 'reference_interne', 'chantiers_reference_interne_norm_uniq');
select pg_temp.creer_unicite_reference('public.fournisseurs', 'reference', 'fournisseurs_reference_norm_uniq');
select pg_temp.creer_unicite_reference('public.prestations_catalogue', 'reference_interne', 'prestations_catalogue_reference_interne_norm_uniq');
select pg_temp.creer_unicite_reference('public.articles_stock', 'reference_interne', 'articles_stock_reference_interne_norm_uniq');
select pg_temp.creer_unicite_reference('public.ouvrages', 'reference_interne', 'ouvrages_reference_interne_norm_uniq');


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 9. Attribution des références manquantes, à la demande
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- Rien n'est attribué rétroactivement par cette migration (sauf la reprise du stock, bloc 4) : c'est un
-- geste explicite de l'entreprise, par nature d'objet, dans l'ordre de création. Chaque attribution est
-- journalisée (déclencheur du bloc 7) sous l'identité de celui qui la demande.
create or replace function public.attribuer_references_manquantes(p_entreprise_id uuid, p_entite text)
returns integer
language plpgsql
security definer
set search_path = public
as $$
declare
  v_permission text;
  v_table      regclass;
  v_ordre      text;
  v_id         uuid;
  v_nombre     integer := 0;
begin
  v_permission := case p_entite
    when 'client' then 'gerer_clients' when 'chantier' then 'gerer_chantiers'
    when 'article' then 'gerer_devis' when 'ouvrage' then 'gerer_ouvrages' end;
  if v_permission is null then
    raise exception 'Nature d''objet non prise en charge : %', p_entite using errcode = '22023';
  end if;
  if not public.est_membre_actif(p_entreprise_id) or not public.a_permission(p_entreprise_id, v_permission) then
    raise exception 'Accès refusé' using errcode = '42501';
  end if;

  v_table := case p_entite
    when 'client' then 'public.clients'::regclass when 'chantier' then 'public.chantiers'::regclass
    when 'article' then 'public.prestations_catalogue'::regclass when 'ouvrage' then 'public.ouvrages'::regclass end;
  v_ordre := case p_entite when 'ouvrage' then 'cree_le' else 'created_at' end;

  for v_id in execute format(
    'select id from %s where entreprise_id = $1 and reference_interne is null order by %I, id for update',
    v_table, v_ordre) using p_entreprise_id
  loop
    execute format('update %s set reference_interne = $1 where id = $2', v_table)
      using public.generer_reference_interne(p_entreprise_id, p_entite), v_id;
    v_nombre := v_nombre + 1;
  end loop;
  return v_nombre;
end $$;

revoke all on function public.attribuer_references_manquantes(uuid, text) from public, anon, service_role;
grant execute on function public.attribuer_references_manquantes(uuid, text) to authenticated;


-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- 10. RLS et droits
-- ─────────────────────────────────────────────────────────────────────────────────────────────────────
-- service_role : aucun droit (aligné sur 20260902000255).
alter table public.references_parametres enable row level security;
drop policy if exists membres_lecture on public.references_parametres;
create policy membres_lecture on public.references_parametres
  for select to authenticated using (public.est_membre_actif(entreprise_id));
drop policy if exists parametres_insert on public.references_parametres;
create policy parametres_insert on public.references_parametres
  for insert to authenticated with check (public.a_permission(entreprise_id, 'gerer_parametres'));
drop policy if exists parametres_update on public.references_parametres;
create policy parametres_update on public.references_parametres
  for update to authenticated using (public.a_permission(entreprise_id, 'gerer_parametres'))
  with check (public.a_permission(entreprise_id, 'gerer_parametres'));
revoke all on public.references_parametres from public, anon, authenticated, service_role;
grant select, insert, update on public.references_parametres to authenticated;

alter table public.catalogue_codes_fournisseurs enable row level security;
drop policy if exists membres_lecture on public.catalogue_codes_fournisseurs;
create policy membres_lecture on public.catalogue_codes_fournisseurs
  for select to authenticated using (public.est_membre_actif(entreprise_id));
drop policy if exists lecture_selon_module on public.catalogue_codes_fournisseurs;
create policy lecture_selon_module on public.catalogue_codes_fournisseurs
  as restrictive for select to authenticated using (
    case when prestation_id is not null
         then public.a_permission(entreprise_id, 'acces_devis') or public.a_permission(entreprise_id, 'acces_ouvrages')
         else public.a_permission(entreprise_id, 'acces_stock') end
    or public.a_permission(entreprise_id, 'acces_achats'));
drop policy if exists gestion_insert on public.catalogue_codes_fournisseurs;
create policy gestion_insert on public.catalogue_codes_fournisseurs
  for insert to authenticated with check (
    public.est_membre_actif(entreprise_id) and
    case when prestation_id is not null then public.a_permission(entreprise_id, 'gerer_devis')
         else public.a_permission(entreprise_id, 'gerer_stock') end);
drop policy if exists gestion_update on public.catalogue_codes_fournisseurs;
create policy gestion_update on public.catalogue_codes_fournisseurs
  for update to authenticated
  using (case when prestation_id is not null then public.a_permission(entreprise_id, 'gerer_devis')
              else public.a_permission(entreprise_id, 'gerer_stock') end)
  with check (case when prestation_id is not null then public.a_permission(entreprise_id, 'gerer_devis')
                   else public.a_permission(entreprise_id, 'gerer_stock') end);
drop policy if exists gestion_delete on public.catalogue_codes_fournisseurs;
create policy gestion_delete on public.catalogue_codes_fournisseurs
  for delete to authenticated
  using (case when prestation_id is not null then public.a_permission(entreprise_id, 'gerer_devis')
              else public.a_permission(entreprise_id, 'gerer_stock') end);
revoke all on public.catalogue_codes_fournisseurs from public, anon, authenticated, service_role;
grant select, insert, update, delete on public.catalogue_codes_fournisseurs to authenticated;

alter table public.historique_objets enable row level security;
drop policy if exists lecture_selon_module on public.historique_objets;
create policy lecture_selon_module on public.historique_objets
  for select to authenticated using (
    public.est_membre_actif(entreprise_id)
    and exists (select 1 from unnest(public.permissions_lecture_historique(ressource)) k
                where public.a_permission(entreprise_id, k))
    and (not sensible or public.a_permission(entreprise_id, 'voir_couts_devis')));
revoke all on public.historique_objets from public, anon, authenticated, service_role;
grant select on public.historique_objets to authenticated;

revoke all on function public.reference_generation_auto(uuid, text) from public, anon, service_role;
grant execute on function public.reference_generation_auto(uuid, text) to authenticated;
revoke all on function public.doublons_references(uuid) from public, anon, service_role;
grant execute on function public.doublons_references(uuid) to authenticated;
revoke all on function public.doublons_references_catalogue(uuid) from public, anon, service_role;
grant execute on function public.doublons_references_catalogue(uuid) to authenticated;

notify pgrst, 'reload schema';
