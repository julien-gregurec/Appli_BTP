# ELSATIA Gestion Pro — exemple Vercel Preview isolé
# Aucun secret réel ni domaine officiel. Remplacer uniquement dans les variables Vercel Preview.

# Obligatoires immédiatement
NEXT_PUBLIC_APP_URL=https://nom-stable-preview.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HMAC_KEY=
DISABLE_EMAIL_LOGIN=false
FEATURE_BOUTIQUE_ENABLED=false
FEATURE_CRONS_ENABLED=false
FEATURE_AI_ENABLED=false

# Stripe Billing — MODE TEST UNIQUEMENT. Toute clé ou tout Price ID live est interdit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_ABONNEMENT_SECRET=
STRIPE_PRICE_MINI_MENSUEL=
STRIPE_PRICE_MINI_ANNUEL=
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_BUSINESS_MENSUEL=
STRIPE_PRICE_BUSINESS_ANNUEL=
STRIPE_PRICE_ENTREPRISE_MENSUEL=
STRIPE_PRICE_ENTREPRISE_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_MINI_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_MINI_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_PRO_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_PRO_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_BUSINESS_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_BUSINESS_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_ANNUEL=
STRIPE_AUTOMATIC_TAX_ENABLED=false

# OpenAI conditionnel — laisser vide tant que FEATURE_AI_ENABLED=false.
# Renseigner la clé uniquement comme variable serveur Vercel Preview, jamais dans Git.
OPENAI_API_KEY=
OPENAI_MODEL=

# Services reportés — documentés sans valeur et à ne pas activer pour la première Preview.
# Stripe Connect et boutique
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_BOUTIQUE_SECRET=
# Powens
POWENS_API_BASE_URL=
POWENS_WEBVIEW_BASE_URL=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
# Notifications push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATIONS_WEBHOOK_SECRET=
# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# E-mails avancés
SUPPORT_EMAIL=
EMAIL_FROM_NAME=ELSATIA
EMAIL_FROM_ADDRESS=
# Banque et import paie
BANK_DATA_ENCRYPTION_KEY=
PAYROLL_IMPORT_SECRET=

# CRON_SECRET n'est requis que lorsque FEATURE_CRONS_ENABLED=true.
CRON_SECRET=

# ── Variables ajoutées d'après config/env-manifest.json (inventaire : noms seulement) ──
# Légende : [requise|facultative] [serveur|public] — usage. Aucune valeur réelle ; les secrets restent vides.
# [requise] [serveur] — INDICATEUR D'ENVIRONNEMENT CANONIQUE : local | test | preview | production.
ELSATIA_APPLICATION_ENV=preview
# [facultative] [serveur] — Ouvre la souscription publique en ligne.
ABONNEMENTS_PUBLICS_OUVERTS=false
# [facultative] [serveur] — Deuxième verrou du mode démonstration locale : refusé en production, en preview et sur Vercel, et exige une URL Supabase locale.
ELSATIA_LOCAL_DEMO=false
# [facultative] [serveur] — Sous-drapeau de FEATURE_AI_ENABLED : génération assistée de devis (rollback isolé).
FEATURE_AI_DEVIS_ENABLED=false
# [facultative] [serveur] — Envoi AUTOMATIQUE des relances de factures (cron).
FEATURE_RELANCES_AUTO_ENABLED=false
# [requise] [serveur] — Mode Stripe attendu par les webhooks d'abonnement : test | live.
STRIPE_WEBHOOK_EXPECTED_MODE=test
# [facultative tant que des abonnements de génération précédente existent] [serveur] — Registre JSON (identifiants de Price, non secrets) des générations tarifaires précédentes, tolérées pour les abonnements existants.
STRIPE_PRICE_BASE_GENERATIONS_PRECEDENTES=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du compte supplémentaire par RÔLE administratif (annuel).
STRIPE_PRICE_COMPTE_SUP_ROLE_ADMINISTRATIF_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du compte supplémentaire par RÔLE administratif (mensuel).
STRIPE_PRICE_COMPTE_SUP_ROLE_ADMINISTRATIF_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du compte supplémentaire par RÔLE chef equipe (annuel).
STRIPE_PRICE_COMPTE_SUP_ROLE_CHEF_EQUIPE_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du compte supplémentaire par RÔLE chef equipe (mensuel).
STRIPE_PRICE_COMPTE_SUP_ROLE_CHEF_EQUIPE_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du compte supplémentaire par RÔLE terrain (annuel).
STRIPE_PRICE_COMPTE_SUP_ROLE_TERRAIN_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du compte supplémentaire par RÔLE terrain (mensuel).
STRIPE_PRICE_COMPTE_SUP_ROLE_TERRAIN_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du pack de crédits IA (achat ponctuel, sans périodicité).
STRIPE_PRICE_IA_CREDITS_PACK_PONCTUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID de l'option IA intensive (annuel).
STRIPE_PRICE_IA_INTENSIVE_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID de l'option IA intensive (mensuel).
STRIPE_PRICE_IA_INTENSIVE_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module materiel vehicules (annuel).
STRIPE_PRICE_MODULE_MATERIEL_VEHICULES_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module materiel vehicules (mensuel).
STRIPE_PRICE_MODULE_MATERIEL_VEHICULES_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module notes frais (annuel).
STRIPE_PRICE_MODULE_NOTES_FRAIS_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module notes frais (mensuel).
STRIPE_PRICE_MODULE_NOTES_FRAIS_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module pointage (annuel).
STRIPE_PRICE_MODULE_POINTAGE_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module pointage (mensuel).
STRIPE_PRICE_MODULE_POINTAGE_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module rentabilite avancee (annuel).
STRIPE_PRICE_MODULE_RENTABILITE_AVANCEE_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module rentabilite avancee (mensuel).
STRIPE_PRICE_MODULE_RENTABILITE_AVANCEE_MENSUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module stock (annuel).
STRIPE_PRICE_MODULE_STOCK_ANNUEL=
# [facultative dès que les abonnements en ligne sont ouverts (ABONNEMENTS_PUBLICS_OUVERTS=true ou abonnement Stripe existant)] [serveur] — Price ID du module stock (mensuel).
STRIPE_PRICE_MODULE_STOCK_MENSUEL=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Price ID Stripe de l'abonnement Tools annuel.
STRIPE_TOOLS_PRICE_ANNUAL=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Price ID Stripe de l'abonnement Tools mensuel.
STRIPE_TOOLS_PRICE_MONTHLY=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Clé secrète Stripe dédiée à la facturation de Tools.
STRIPE_TOOLS_SECRET_KEY=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Secret de signature du webhook Stripe de Tools.
STRIPE_TOOLS_WEBHOOK_SECRET=
# [facultative dès que l'envoi d'e-mails est activé] [serveur] — Clé API du canal e-mail commun ELSATIA (Brevo) : invitations, réinitialisations, relances.
BREVO_API_KEY=
# [facultative dès que l'attestation d'état Stripe est active] [serveur] — Identifiant (non secret) de la paire Ed25519 d'attestation d'état Stripe ; doit correspondre à une ligne du registre stripe_attestation.public_keys.
STRIPE_STATE_ATTESTATION_KEY_ID=
# [facultative dès que l'attestation d'état Stripe est active] [serveur] — Clé privée Ed25519 (base64) qui signe l'attestation d'état Stripe.
STRIPE_STATE_ATTESTATION_PRIVATE_KEY_B64=
# [facultative dès que les achats iOS Tools sont ouverts] [serveur] — Certificat racine Apple (public) pour valider les achats iOS de Tools.
APPLE_ROOT_CA_BASE64=
# [facultative dès que les achats Android Tools sont ouverts] [serveur] — Audience attendue des notifications Google Play RTDN.
GOOGLE_PLAY_RTDN_AUDIENCE=
# [facultative dès que les achats Android Tools sont ouverts] [serveur] — E-mail du compte de service émetteur des notifications RTDN.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
# [facultative dès que les achats Android Tools sont ouverts] [serveur] — Compte de service Google Play (JSON contenant une clé privée) pour valider les achats Android de Tools.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# [requise] [public] — Origine publique de Colors : metadataBase et redirectTo de la réinitialisation de mot de passe.
NEXT_PUBLIC_COLORS_URL=
# [facultative dès que Tools appelle l'API de facturation] [serveur] — Liste blanche CORS (séparée par des virgules) des origines autorisées à appeler l'API de facturation.
TOOLS_ALLOWED_ORIGINS=
# [facultative dès que la facturation Tools est ouverte] [serveur] — Origine de Tools utilisée par Gestion Pro pour composer les URL de retour Stripe Checkout de Tools.
TOOLS_APP_URL=
