# ELSATIA Gestion Pro — exemple Vercel Preview isolé
# Aucun secret réel ni domaine officiel. Remplacer uniquement dans les variables Vercel Preview.

# Obligatoires immédiatement
NEXT_PUBLIC_APP_URL=https://nom-stable-preview.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HMAC_KEY=
DISABLE_EMAIL_LOGIN=false
FEATURE_BOUTIQUE_ENABLED=false
FEATURE_CRONS_ENABLED=false
FEATURE_AI_ENABLED=false

# Stripe Billing — MODE TEST UNIQUEMENT. Toute clé ou tout Price ID live est interdit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_ABONNEMENT_SECRET=
STRIPE_PRICE_MINI_MENSUEL=
STRIPE_PRICE_MINI_ANNUEL=
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_BUSINESS_MENSUEL=
STRIPE_PRICE_BUSINESS_ANNUEL=
STRIPE_PRICE_ENTREPRISE_MENSUEL=
STRIPE_PRICE_ENTREPRISE_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_MINI_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_MINI_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_PRO_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_PRO_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_BUSINESS_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_BUSINESS_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_ANNUEL=
STRIPE_AUTOMATIC_TAX_ENABLED=false

# OpenAI conditionnel — laisser vide tant que FEATURE_AI_ENABLED=false.
# Renseigner la clé uniquement comme variable serveur Vercel Preview, jamais dans Git.
OPENAI_API_KEY=
OPENAI_MODEL=

# Services reportés — documentés sans valeur et à ne pas activer pour la première Preview.
# Stripe Connect et boutique
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_BOUTIQUE_SECRET=
# Powens
POWENS_API_BASE_URL=
POWENS_WEBVIEW_BASE_URL=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
# Notifications push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATIONS_WEBHOOK_SECRET=
# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# E-mails avancés
SUPPORT_EMAIL=
EMAIL_FROM_NAME=ELSATIA
EMAIL_FROM_ADDRESS=
# Banque et import paie
BANK_DATA_ENCRYPTION_KEY=
PAYROLL_IMPORT_SECRET=

# CRON_SECRET n'est requis que lorsque FEATURE_CRONS_ENABLED=true.
CRON_SECRET=
