# ELSATIA — secrets OPÉRATEUR de la qualification Preview distante.
# Copier en ~/elsatia-preview/qualification.env (chmod 600), JAMAIS dans le dépôt.
# Les variables peuvent aussi être exportées dans le shell (le shell l'emporte sur ce fichier).

# URL PostgreSQL de la Preview UNIQUEMENT (Dashboard Supabase → Connect → Session pooler ou Direct).
# Refusée si la ref n'est pas celle du fichier de cible, et toujours refusée pour la Production.
ELSATIA_PREVIEW_DB_URL=

# Jeton Vercel (Account Settings → Tokens), portée limitée à l'équipe ; lecture suffit.
VERCEL_TOKEN=

# Mots de passe des deux comptes de recette déclarés dans preview-target.json (qa.tenant_a / qa.tenant_b).
ELSATIA_QA_PASSWORD_A=
ELSATIA_QA_PASSWORD_B=

# Facultatif : jeton Supabase (Account → Access Tokens) — nom du projet, supabase link, logs.
# REQUIS si des migrations sont à appliquer et que la CLI n'est pas encore liée.
SUPABASE_ACCESS_TOKEN=

# Facultatif : Deployment Protection Vercel → Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Facultatif : Redis du worker Studio (Studio hors périmètre V5 : laisser vide sauf décision).
STUDIO_REDIS_URL=
