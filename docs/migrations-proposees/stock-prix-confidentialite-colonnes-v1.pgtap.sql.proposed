-- ELSATIA-STOCK-PRIX-CONFIDENTIALITE-COLONNES-V1 — suite pgTAP PROPOSÉE
--
-- ⚠️  Extension `.pgtap.sql.proposed` : ce fichier ne vit PAS dans `supabase/tests/` tant
--     que `stock-prix-confidentialite-colonnes-v1.sql.proposed` n'est pas numéroté. Il
--     sera déplacé tel quel (renommé en `.test.sql`) au moment de l'intégration.
--
-- Pré-requis : base au ledger du Train V3 + le correctif `.sql.proposed` appliqué.
-- Sans le correctif, la suite échoue dès l'assertion 2 (fuite), puis s'interrompt à
-- l'assertion 8 (couts_stock_par_chantier absente).
--
-- Décor autonome (aucun `\i fixtures/…`) pour rester exécutable depuis
-- `docs/migrations-proposees/`. UUID en e…/f… : aucune collision avec
-- `supabase/tests/fixtures/isolation_multitenant.inc` (a…/b…).
--
-- Personas (entreprise E sauf mention) :
--   ouvrier      acces_stock                                   → aucun prix
--   magasinier   acces_stock, gerer_stock, voir_prix_stock     → prix via RPC seulement
--   comptable    acces_rentabilite                             → coût agrégé par chantier
--   gestionnaire acces_stock, gerer_stock, gerer_prix_stock    → écritures inchangées
--   comptable F  acces_rentabilite dans l'entreprise F         → isolation multitenant

begin;
create extension if not exists pgtap with schema extensions;
select plan(36);

set local elsatia.capacite_personnes_bypass = 'on';

-- ── Décor ─────────────────────────────────────────────────────────────────────
insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at, created_at, updated_at)
values
  ('00000000-0000-0000-0000-000000000000','e1000000-0000-0000-0000-000000000001','authenticated','authenticated','stkprix-ouvrier-e@invalid.local',crypt('t',gen_salt('bf')),now(),now(),now()),
  ('00000000-0000-0000-0000-000000000000','e1000000-0000-0000-0000-000000000002','authenticated','authenticated','stkprix-magasinier-e@invalid.local',crypt('t',gen_salt('bf')),now(),now(),now()),
  ('00000000-0000-0000-0000-000000000000','e1000000-0000-0000-0000-000000000003','authenticated','authenticated','stkprix-comptable-e@invalid.local',crypt('t',gen_salt('bf')),now(),now(),now()),
  ('00000000-0000-0000-0000-000000000000','e1000000-0000-0000-0000-000000000004','authenticated','authenticated','stkprix-gestionnaire-e@invalid.local',crypt('t',gen_salt('bf')),now(),now(),now()),
  ('00000000-0000-0000-0000-000000000000','f1000000-0000-0000-0000-000000000001','authenticated','authenticated','stkprix-comptable-f@invalid.local',crypt('t',gen_salt('bf')),now(),now(),now());

insert into public.utilisateurs (id, prenom, nom) values
  ('e1000000-0000-0000-0000-000000000001','Ouvrier','E'),
  ('e1000000-0000-0000-0000-000000000002','Magasinier','E'),
  ('e1000000-0000-0000-0000-000000000003','Comptable','E'),
  ('e1000000-0000-0000-0000-000000000004','Gestionnaire','E'),
  ('f1000000-0000-0000-0000-000000000001','Comptable','F')
-- L'insertion dans auth.users crée déjà la ligne (même motif que la fixture canonique).
on conflict (id) do update set prenom = excluded.prenom, nom = excluded.nom;

insert into public.entreprises (id, nom, code_adhesion) values
  ('e0000000-0000-0000-0000-000000000001','Entreprise prix stock E','SPXE0001'),
  ('f0000000-0000-0000-0000-000000000001','Entreprise prix stock F','SPXF0001');

insert into public.postes (id, entreprise_id, nom) values
  ('e2000000-0000-0000-0000-000000000001','e0000000-0000-0000-0000-000000000001','Ouvrier E'),
  ('e2000000-0000-0000-0000-000000000002','e0000000-0000-0000-0000-000000000001','Magasinier E'),
  ('e2000000-0000-0000-0000-000000000003','e0000000-0000-0000-0000-000000000001','Comptable E'),
  ('e2000000-0000-0000-0000-000000000004','e0000000-0000-0000-0000-000000000001','Gestionnaire prix E'),
  ('f2000000-0000-0000-0000-000000000001','f0000000-0000-0000-0000-000000000001','Comptable F');

insert into public.utilisateurs_entreprises (utilisateur_id, entreprise_id, poste_id, statut) values
  ('e1000000-0000-0000-0000-000000000001','e0000000-0000-0000-0000-000000000001','e2000000-0000-0000-0000-000000000001','actif'),
  ('e1000000-0000-0000-0000-000000000002','e0000000-0000-0000-0000-000000000001','e2000000-0000-0000-0000-000000000002','actif'),
  ('e1000000-0000-0000-0000-000000000003','e0000000-0000-0000-0000-000000000001','e2000000-0000-0000-0000-000000000003','actif'),
  ('e1000000-0000-0000-0000-000000000004','e0000000-0000-0000-0000-000000000001','e2000000-0000-0000-0000-000000000004','actif'),
  ('f1000000-0000-0000-0000-000000000001','f0000000-0000-0000-0000-000000000001','f2000000-0000-0000-0000-000000000001','actif');

insert into public.permissions_poste (entreprise_id, poste_id, cle_permission, autorise)
select p.entreprise_id, p.id, d.cle, true
from public.postes p
join (values
  ('e2000000-0000-0000-0000-000000000001'::uuid, 'acces_stock'),
  ('e2000000-0000-0000-0000-000000000002'::uuid, 'acces_stock'),
  ('e2000000-0000-0000-0000-000000000002'::uuid, 'gerer_stock'),
  ('e2000000-0000-0000-0000-000000000002'::uuid, 'voir_prix_stock'),
  ('e2000000-0000-0000-0000-000000000003'::uuid, 'acces_rentabilite'),
  ('e2000000-0000-0000-0000-000000000004'::uuid, 'acces_stock'),
  ('e2000000-0000-0000-0000-000000000004'::uuid, 'gerer_stock'),
  ('e2000000-0000-0000-0000-000000000004'::uuid, 'gerer_prix_stock'),
  ('f2000000-0000-0000-0000-000000000001'::uuid, 'acces_rentabilite')
) as v(poste_id, cle) on v.poste_id = p.id
join public.permissions_disponibles d on d.cle = v.cle;

insert into public.clients (id, entreprise_id, reference_interne, nom, type, statut) values
  ('e3000000-0000-0000-0000-000000000001','e0000000-0000-0000-0000-000000000001','STKPRIX_E_CLI','Client E','particulier','actif'),
  ('f3000000-0000-0000-0000-000000000001','f0000000-0000-0000-0000-000000000001','STKPRIX_F_CLI','Client F','particulier','actif');

insert into public.chantiers (id, entreprise_id, client_id, nom, statut) values
  ('e4000000-0000-0000-0000-000000000001','e0000000-0000-0000-0000-000000000001','e3000000-0000-0000-0000-000000000001','Chantier E consommateur','en_cours'),
  ('e4000000-0000-0000-0000-000000000002','e0000000-0000-0000-0000-000000000001','e3000000-0000-0000-0000-000000000001','Chantier E sans sortie','en_cours'),
  ('f4000000-0000-0000-0000-000000000001','f0000000-0000-0000-0000-000000000001','f3000000-0000-0000-0000-000000000001','Chantier F consommateur','en_cours');

insert into public.articles_stock (id, entreprise_id, reference, designation, quantite_stock, prix_achat_ht, prix_vente_ht) values
  ('e5000000-0000-0000-0000-000000000001','e0000000-0000-0000-0000-000000000001','STKPRIX_E_001','Article E',10,5,8),
  ('f5000000-0000-0000-0000-000000000001','f0000000-0000-0000-0000-000000000001','STKPRIX_F_001','Article F',10,7,11);

-- Une sortie de 2 (coût 2 × 5 = 10) et une ENTRÉE sur le même chantier, qui ne doit
-- pas compter ; une sortie de 1 dans F (coût 7).
insert into public.mouvements_stock (id, entreprise_id, article_id, chantier_id, type, quantite, motif) values
  ('e6000000-0000-0000-0000-000000000001','e0000000-0000-0000-0000-000000000001','e5000000-0000-0000-0000-000000000001','e4000000-0000-0000-0000-000000000001','sortie',2,'Sortie E'),
  ('e6000000-0000-0000-0000-000000000002','e0000000-0000-0000-0000-000000000001','e5000000-0000-0000-0000-000000000001','e4000000-0000-0000-0000-000000000001','entree',5,'Retour E'),
  ('f6000000-0000-0000-0000-000000000001','f0000000-0000-0000-0000-000000000001','f5000000-0000-0000-0000-000000000001','f4000000-0000-0000-0000-000000000001','sortie',1,'Sortie F');

-- ── A. Structure et privilèges (1-13) ─────────────────────────────────────────
select columns_are('public', 'articles_stock', array[
  'id','entreprise_id','reference','designation','unite','quantite_stock','seuil_alerte',
  'prix_achat_ht','emplacement','actif','created_at','updated_at','zone_id','marque',
  'code_barres','prix_vente_ht'
], '1. articles_stock porte exactement les 16 colonnes classées (toute nouvelle colonne impose une décision)');

select is(has_table_privilege('authenticated', 'public.articles_stock', 'select'), false,
  '2. authenticated n''a plus de SELECT au niveau TABLE sur articles_stock');
select is(has_column_privilege('authenticated', 'public.articles_stock', 'prix_achat_ht', 'select'), false,
  '3. prix_achat_ht n''est pas lisible par authenticated');
select is(has_column_privilege('authenticated', 'public.articles_stock', 'prix_vente_ht', 'select'), false,
  '4. prix_vente_ht n''est pas lisible par authenticated');
select is(
  (select array_agg(a.attname::text order by a.attname)
   from pg_attribute a
   where a.attrelid = 'public.articles_stock'::regclass and a.attnum > 0 and not a.attisdropped
     and has_column_privilege('authenticated', a.attrelid, a.attnum, 'select')),
  array['actif','code_barres','created_at','designation','emplacement','entreprise_id','id',
        'marque','quantite_stock','reference','seuil_alerte','unite','updated_at','zone_id'],
  '5. authenticated lit exactement les 14 colonnes non tarifaires (liste 00108)');
select is(has_any_column_privilege('anon', 'public.articles_stock', 'select'), false,
  '6. anon ne lit aucune colonne de articles_stock');
select ok(
  has_table_privilege('authenticated', 'public.articles_stock', 'insert')
  and has_table_privilege('authenticated', 'public.articles_stock', 'update')
  and has_table_privilege('authenticated', 'public.articles_stock', 'delete'),
  '7. les privilèges d''écriture de authenticated sont inchangés (gardés par RLS + trigger prix)');
select is((select prosecdef from pg_proc where oid = 'public.couts_stock_par_chantier(uuid,uuid)'::regprocedure), true,
  '8. couts_stock_par_chantier est security definer');
select ok((select 'search_path=public' = any(proconfig) from pg_proc where oid = 'public.couts_stock_par_chantier(uuid,uuid)'::regprocedure),
  '9. couts_stock_par_chantier fixe search_path=public');
select is(has_function_privilege('anon', 'public.couts_stock_par_chantier(uuid,uuid)', 'execute'), false,
  '10. anon ne peut pas exécuter couts_stock_par_chantier');
select is(has_function_privilege('public', 'public.couts_stock_par_chantier(uuid,uuid)', 'execute'), false,
  '11. PUBLIC ne peut pas exécuter couts_stock_par_chantier');
select is(has_function_privilege('authenticated', 'public.couts_stock_par_chantier(uuid,uuid)', 'execute'), true,
  '12. authenticated peut exécuter couts_stock_par_chantier');
select is(has_function_privilege('authenticated', 'public.articles_stock_avec_prix(uuid)', 'execute'), true,
  '13. la voie officielle articles_stock_avec_prix reste ouverte à authenticated');

set local role authenticated;

-- ── B. Ouvrier E : membre actif sans aucun droit prix (14-20) ────────────────
select set_config('request.jwt.claims', '{"sub":"e1000000-0000-0000-0000-000000000001","role":"authenticated"}', true);

select results_eq(
  $$select reference::text from public.articles_stock order by reference$$,
  $$values ('STKPRIX_E_001'::text)$$,
  '14. l''ouvrier lit toujours les colonnes non tarifaires, et seulement son entreprise');
select throws_ok($$select prix_achat_ht from public.articles_stock$$, '42501', null,
  '15. l''ouvrier ne lit plus prix_achat_ht directement');
select throws_ok($$select prix_vente_ht from public.articles_stock$$, '42501', null,
  '16. l''ouvrier ne lit plus prix_vente_ht directement');
select throws_ok($$select * from public.articles_stock$$, '42501', null,
  '17. select * (forme PostgREST par défaut) est refusé');
select throws_ok(
  $$select m.quantite, a.prix_achat_ht from public.mouvements_stock m join public.articles_stock a on a.id = m.article_id$$,
  '42501', null,
  '18. la jointure mouvements -> prix (embed /rentabilite actuel) est refusée');
select throws_ok(
  $$select * from public.articles_stock_avec_prix('e0000000-0000-0000-0000-000000000001')$$,
  'P0001', 'Accès aux prix du stock refusé',
  '19. la RPC prix refuse l''ouvrier (inchangé)');
select is_empty(
  $$select * from public.couts_stock_par_chantier('e0000000-0000-0000-0000-000000000001')$$,
  '20. sans acces_rentabilite, couts_stock_par_chantier ne renvoie rien');

-- ── C. Magasinier E : voir_prix_stock (21-23) ─────────────────────────────────
select set_config('request.jwt.claims', '{"sub":"e1000000-0000-0000-0000-000000000002","role":"authenticated"}', true);

select results_eq(
  $$select reference::text, prix_achat_ht::numeric, prix_vente_ht::numeric
    from public.articles_stock_avec_prix('e0000000-0000-0000-0000-000000000001') order by reference$$,
  $$values ('STKPRIX_E_001'::text, 5::numeric, 8::numeric)$$,
  '21. voir_prix_stock lit les prix par la RPC officielle');
select throws_ok($$select prix_achat_ht from public.articles_stock$$, '42501', null,
  '22. même habilité, la lecture DIRECTE reste refusée : la RPC est l''unique voie');
select throws_ok(
  $$update public.articles_stock set prix_achat_ht = 99 where id = 'e5000000-0000-0000-0000-000000000001'$$,
  'P0001', 'Modification des prix du stock non autorisée',
  '23. gerer_stock sans gerer_prix_stock ne modifie toujours pas un prix (trigger 00108)');

-- ── D. Comptable E : acces_rentabilite seul (24-28) ───────────────────────────
select set_config('request.jwt.claims', '{"sub":"e1000000-0000-0000-0000-000000000003","role":"authenticated"}', true);

select results_eq(
  $$select chantier_id, total from public.couts_stock_par_chantier('e0000000-0000-0000-0000-000000000001')$$,
  $$values ('e4000000-0000-0000-0000-000000000001'::uuid, 10::numeric)$$,
  '24. coût stock du chantier = sorties × prix d''achat (l''entrée est ignorée)');
select results_eq(
  $$select chantier_id, total from public.couts_stock_par_chantier('e0000000-0000-0000-0000-000000000001', 'e4000000-0000-0000-0000-000000000001')$$,
  $$values ('e4000000-0000-0000-0000-000000000001'::uuid, 10::numeric)$$,
  '25. le filtre p_chantier_id (analyse IA d''un chantier) renvoie le même total');
select is_empty(
  $$select * from public.couts_stock_par_chantier('e0000000-0000-0000-0000-000000000001', 'e4000000-0000-0000-0000-000000000002')$$,
  '26. un chantier sans sortie n''a pas de ligne');
select is_empty(
  $$select * from public.couts_stock_par_chantier('f0000000-0000-0000-0000-000000000001')$$,
  '27. le comptable de E ne lit pas les coûts de F');
select throws_ok(
  $$select * from public.articles_stock_avec_prix('e0000000-0000-0000-0000-000000000001')$$,
  'P0001', 'Accès aux prix du stock refusé',
  '28. acces_rentabilite ne donne PAS les prix unitaires');

-- ── E. Comptable F : isolation (29-30) ────────────────────────────────────────
select set_config('request.jwt.claims', '{"sub":"f1000000-0000-0000-0000-000000000001","role":"authenticated"}', true);

select results_eq(
  $$select chantier_id, total from public.couts_stock_par_chantier('f0000000-0000-0000-0000-000000000001')$$,
  $$values ('f4000000-0000-0000-0000-000000000001'::uuid, 7::numeric)$$,
  '29. le comptable de F lit le coût de son chantier');
select is_empty(
  $$select * from public.couts_stock_par_chantier('e0000000-0000-0000-0000-000000000001')$$,
  '30. le comptable de F ne lit pas les coûts de E');

-- ── F. Gestionnaire prix E : chemins d'écriture de l'application (31-36) ──────
select set_config('request.jwt.claims', '{"sub":"e1000000-0000-0000-0000-000000000004","role":"authenticated"}', true);

select lives_ok(
  $$update public.articles_stock set prix_achat_ht = 6, prix_vente_ht = 9
    where id = 'e5000000-0000-0000-0000-000000000001' and entreprise_id = 'e0000000-0000-0000-0000-000000000001'$$,
  '31. modifier un prix sans le relire reste possible (actions/stock.ts:53)');
select lives_ok(
  $$insert into public.articles_stock (entreprise_id, reference, designation, prix_achat_ht, prix_vente_ht)
    values ('e0000000-0000-0000-0000-000000000001', 'STKPRIX_E_002', 'Article E bis', 3, 4)$$,
  '32. créer un article avec prix reste possible (actions/stock.ts:30)');
select throws_ok(
  $$insert into public.articles_stock (entreprise_id, reference, designation, prix_achat_ht, prix_vente_ht)
    values ('e0000000-0000-0000-0000-000000000001', 'STKPRIX_E_001', 'Article E', 6.5, 9.5)
    on conflict (entreprise_id, reference) do update
      set designation = excluded.designation,
          prix_achat_ht = excluded.prix_achat_ht,
          prix_vente_ht = excluded.prix_vente_ht$$,
  '42501', null,
  '33. l''upsert PostgREST (SET prix = EXCLUDED.prix, actions/import.ts:261) est refusé : dépendance D2');
select lives_ok(
  $$select public.importer_articles_stock('e0000000-0000-0000-0000-000000000001', 'catalogue',
      '[{"reference":"STKPRIX_E_001","designation":"Article E","prix_achat_ht":6.5}]'::jsonb)$$,
  '34. la voie de remplacement importer_articles_stock met à jour le prix (D2)');
select throws_ok(
  $$insert into public.articles_stock (entreprise_id, reference, designation)
    values ('e0000000-0000-0000-0000-000000000001', 'STKPRIX_E_003', 'Article E ter') returning prix_achat_ht$$,
  '42501', null,
  '35. RETURNING d''un prix est refusé : jamais de .insert().select("*") côté application');
select results_eq(
  $$select reference::text, prix_achat_ht::numeric
    from public.articles_stock_avec_prix('e0000000-0000-0000-0000-000000000001') order by reference$$,
  $$values ('STKPRIX_E_001'::text, 6.5::numeric), ('STKPRIX_E_002'::text, 3::numeric)$$,
  '36. les prix écrits sont relus par la RPC officielle');

select * from finish();
rollback;
