-- ELSATIA-STOCK-PRIX-CONFIDENTIALITE-COLONNES-V1
--
-- ⚠️  CE FICHIER N'EST PAS UNE MIGRATION CANONIQUE.
--     Extension `.sql.proposed` : il n'est ni exécuté par `supabase db reset`, ni vu
--     par `scripts/verify-migrations.mjs`, et AUCUN numéro de ledger n'est réservé.
--     Numéro fonctionnel maximal connu : 281 (`integration/colors-pilot-readiness-v1`,
--     non fusionnée). Le numéro sera attribué à l'intégration, depuis le train
--     canonique du moment, jamais depuis cette branche.
--
-- Base de référence : `integration/elsatia-ecosystem-train-v3-commercial-platform-v1`
-- @ 52d3282 (278 fichiers, dernier préfixe 20260909000280). La pointe 59e960a
-- n'ajoute que de la documentation : ledger identique.
--
-- ─── Défaut corrigé (confidentialité des prix d'achat, fuite PROUVÉE sur base jetable) ───
--
--   * 00108 (l. 209-213) retire le SELECT table-entière à `authenticated` et n'accorde
--     plus que 14 colonnes, sans `prix_achat_ht` ni `prix_vente_ht`. La lecture des
--     prix passe par `articles_stock_avec_prix` (voir_prix_stock / gerer_prix_stock).
--   * 00189 (l. 10-12) réexécute `grant select on table public.articles_stock to
--     authenticated`. Un privilège TABLE couvre toutes les colonnes : la restriction
--     00108 est annulée (les grants colonne subsistent, mais ne restreignent plus rien).
--   * Aucune migration postérieure ne la rétablit ; 00255 ne révoque que service_role.
--     La seule politique RLS de lecture est `est_membre_actif(entreprise_id)`.
--   * Conséquence : tout membre actif lit prix_achat_ht et prix_vente_ht par PostgREST
--     (`select=*`, colonnes explicites, embed depuis mouvements_stock), alors que la
--     voie officielle `articles_stock_avec_prix` lui répond « Accès aux prix du stock
--     refusé ». 00189 est antérieure à la baseline Production (210 lignes) : la fuite
--     y est probable, mais n'a PAS été mesurée sur la base vivante.
--
-- ─── Pourquoi 00189 avait élargi ───
--
--   /rentabilite (commit 91cac98, 2026-07-26, entre 00108 et 00189) lit
--   `mouvements_stock?select=…,article:articles_stock(prix_achat_ht)`. Sous 00108 cet
--   embed échoue en 42501 pour TOUS les postes, même habilités, puisque le privilège
--   colonne est porté par le rôle `authenticated` et non par la permission métier.
--   Restreindre de nouveau la colonne sans voie contrôlée recasserait la rentabilité :
--   ce fichier ajoute donc `couts_stock_par_chantier`, calquée sur
--   `couts_indemnites_paie_par_chantier` (00147) : agrégat par chantier, jamais de prix
--   unitaire, réservé aux membres actifs qui ont `acces_rentabilite`.
--
-- ─── Ce que ce fichier FAIT ───
--
--   1. vérifie que la table porte exactement les 16 colonnes classées ci-dessous et
--      échoue sinon : une colonne ajoutée d'ici l'intégration doit être déclarée
--      publique ou confidentielle avant application, jamais exposée par défaut ;
--   2. REVOKE SELECT au niveau table (ce qui retire aussi les grants colonne existants),
--      puis GRANT SELECT sur les 14 colonnes non tarifaires, liste 00108 inchangée ;
--   3. crée `couts_stock_par_chantier(p_entreprise_id, p_chantier_id default null)`, qui
--      REFUSE (42501) tout appelant sans acces_rentabilite au lieu de renvoyer un vide (D1) ;
--   4. remplace `importer_articles_stock` et `importer_articles_stock_interne` (mêmes
--      signatures) : prix de vente transmis, prix jamais remis à 0 ni à NULL, refus
--      explicite de toute donnée tarifaire sans gerer_prix_stock (D2) ;
--   5. recharge le cache de schéma PostgREST.
--
-- D3 (expert-comptable) ne demande aucun SQL : le Train V3 ne contient AUCUN modèle de
-- poste expert-comptable (104 : neuf modèles, dont un « comptable » INTERNE) et l'option
-- facturée `expert_comptable` (142) ne porte aucun droit. La suite pgTAP le verrouille.
--
-- ─── Ce que ce fichier NE FAIT PAS ───
--
--   * il ne touche pas INSERT / UPDATE / DELETE : l'écriture des prix reste gardée par
--     le trigger `verifier_droit_prix_stock` (00108) ;
--   * il ne modifie ni `articles_stock_avec_prix` ni `lignes_inventaire_avec_prix` ;
--   * il n'accorde rien à `anon` ni à `service_role` (00189 / 00255 inchangées).
--
-- ─── CODE APPLICATIF — livré dans la MÊME branche, à déployer avec ce SQL ───
--
--   Ordre : SQL puis code. Le code suppose `couts_stock_par_chantier` présente ; s'il
--   tourne sans elle, il affiche « coût du stock indisponible », jamais 0 €.
--
--   * Rentabilité (page + analyse IA) : plus aucune lecture de `prix_achat_ht` ; coût
--     stock par `rpc("couts_stock_par_chantier")`. Refus ou échec → coût et marge
--     « indisponibles », explicitement ; l'analyse IA exige acces_rentabilite et
--     s'interrompt sans appeler l'IA si le coût stock manque (D1).
--   * Import générique « Stock et codes-barres » : `rpc("importer_articles_stock",
--     { p_type: "inventaire" })` au lieu de l'upsert PostgREST (qui échouerait en 42501,
--     pgTAP « upsert refusé ») ; colonnes prix refusées explicitement sans
--     gerer_prix_stock ; cellule prix vide = prix inchangé (D2).
--   * Import de l'écran Stock (`lib/import-stock.ts`) : colonne prix absente ou vide =
--     `null` (prix inchangé) au lieu de 0 ; prix de vente lu ; prix illisible refusé.
--
--   Règle permanente : toute écriture sur articles_stock reste en `return=minimal` ; un
--   `.insert(…).select("*")` ou un RETURNING d'un prix échoue en 42501 (pgTAP).
--
--   D4. `src/app/(app)/stock/page 2.tsx` (copie Finder, `select("*")`) N'EST PAS
--       supprimé ici : lot distinct `chore/remove-finder-duplicate-copies-v1`. Il n'est
--       ni routé ni importé ; après ce SQL son `select("*")` échouerait en 42501 au lieu
--       de fuir. Le test applicatif de garde l'isole nommément.

-- 1. Garde : aucune colonne non classée ────────────────────────────────────────
do $$
declare
  v_publiques constant text[] := array[
    'id', 'entreprise_id', 'reference', 'designation', 'unite', 'quantite_stock',
    'seuil_alerte', 'emplacement', 'actif', 'created_at', 'updated_at', 'marque',
    'code_barres', 'zone_id'
  ];
  v_confidentielles constant text[] := array['prix_achat_ht', 'prix_vente_ht'];
  v_inconnues text;
  v_absentes text;
begin
  select string_agg(a.attname::text, ', ' order by a.attnum)
    into v_inconnues
  from pg_attribute a
  where a.attrelid = 'public.articles_stock'::regclass
    and a.attnum > 0 and not a.attisdropped
    and a.attname::text <> all (v_publiques || v_confidentielles);

  if v_inconnues is not null then
    raise exception 'articles_stock porte des colonnes non classées (%) : les déclarer publiques ou confidentielles dans ce correctif avant de l''appliquer', v_inconnues;
  end if;

  select string_agg(c, ', ')
    into v_absentes
  from unnest(v_publiques || v_confidentielles) as c
  where not exists (
    select 1 from pg_attribute a
    where a.attrelid = 'public.articles_stock'::regclass
      and a.attname = c and a.attnum > 0 and not a.attisdropped
  );

  if v_absentes is not null then
    raise exception 'articles_stock ne porte plus les colonnes attendues (%) : revoir ce correctif', v_absentes;
  end if;
end;
$$;

-- 2. Lecture restreinte aux colonnes non tarifaires ─────────────────────────────
-- Le REVOKE niveau table retire aussi les privilèges colonne : l'état final ne dépend
-- donc pas de l'historique (Fresh, Production 210, ou base déjà corrigée).
revoke select on table public.articles_stock from authenticated;

grant select (
  id, entreprise_id, reference, designation, unite, quantite_stock, seuil_alerte,
  emplacement, actif, created_at, updated_at, marque, code_barres, zone_id
) on table public.articles_stock to authenticated;

-- 3. Coût des sorties de stock par chantier, sans prix unitaire ────────────────
-- Même calcul que l'écran actuel : quantité sortie × prix d'achat COURANT de l'article.
-- Décision D1 (2026-09-11) : un appelant qui n'est pas membre actif ou n'a pas
-- acces_rentabilite reçoit un REFUS explicite (42501), jamais un ensemble vide qu'un
-- écran pourrait afficher comme un coût à 0 €. Un ensemble vide ne signifie donc plus
-- qu'une chose : aucun article sorti vers ce chantier.
create or replace function public.couts_stock_par_chantier(
  p_entreprise_id uuid,
  p_chantier_id uuid default null
)
returns table(chantier_id uuid, total numeric)
language plpgsql security definer stable set search_path = public as $$
begin
  if not public.est_membre_actif(p_entreprise_id)
     or not public.a_permission(p_entreprise_id, 'acces_rentabilite') then
    raise exception 'Accès à la rentabilité refusé : le coût du stock n''est pas communiqué'
      using errcode = '42501';
  end if;

  return query
    select m.chantier_id, sum(m.quantite * a.prix_achat_ht)::numeric
    from public.mouvements_stock m
    join public.articles_stock a
      on a.id = m.article_id
     and a.entreprise_id = m.entreprise_id
    where m.entreprise_id = p_entreprise_id
      and m.type = 'sortie'
      and m.chantier_id is not null
      and (p_chantier_id is null or m.chantier_id = p_chantier_id)
    group by m.chantier_id;
end;
$$;

revoke all on function public.couts_stock_par_chantier(uuid, uuid) from public, anon;
grant execute on function public.couts_stock_par_chantier(uuid, uuid) to authenticated;

-- 4. Import du stock : prix de vente transmis, prix jamais remis à zéro ────────
-- Décision D2 (2026-09-11). Avant ce correctif, `importer_articles_stock_interne`
-- ignorait prix_vente_ht et, sur une référence existante, remettait prix_achat_ht à 0
-- dès que la colonne manquait au fichier. Désormais :
--   * un prix n'est modifié que s'il est FOURNI (clé présente et non nulle) ;
--   * un prix fourni négatif est refusé, jamais ramené à 0 ;
--   * une NOUVELLE référence sans prix prend la valeur par défaut de la colonne (0) ;
--   * toute donnée tarifaire exige gerer_prix_stock : sans elle, l'import entier est
--     refusé (42501) AVANT toute écriture — aucun article, aucun prix n'est modifié ;
--   * la fonction ne renvoie qu'un nombre de lignes, jamais un prix.
-- Signatures inchangées : l'écran Stock (`importerStockAction`) appelle la même RPC ;
-- l'import générique (`importerDonneesAction`) l'appelle désormais aussi.
create or replace function public.importer_articles_stock_interne(p_entreprise_id uuid, p_type text, p_lignes jsonb)
returns integer language plpgsql security definer set search_path = public as $$
declare
  r record;
  v_article public.articles_stock;
  v_nb int := 0;
  v_souhaite numeric;
  v_delta numeric;
begin
  if auth.role() is distinct from 'anon' and not public.est_membre_actif(p_entreprise_id) then
    raise exception 'Accès refusé';
  end if;
  if p_type not in ('catalogue', 'inventaire') then
    raise exception 'Type d’import invalide';
  end if;
  if jsonb_typeof(p_lignes) <> 'array' or jsonb_array_length(p_lignes) = 0 or jsonb_array_length(p_lignes) > 5000 then
    raise exception 'L’import doit contenir entre 1 et 5000 lignes';
  end if;

  for r in
    select * from jsonb_to_recordset(p_lignes) as x(
      reference text, designation text, unite text, prix_achat_ht numeric, prix_vente_ht numeric,
      seuil_alerte numeric, quantite numeric, emplacement text, marque text, code_barres text,
      teinte text, teinte_reference text, code_hex text
    )
  loop
    if nullif(trim(r.reference), '') is null or nullif(trim(r.designation), '') is null then
      raise exception 'Référence et désignation obligatoires à chaque ligne';
    end if;
    if r.prix_achat_ht < 0 or r.prix_vente_ht < 0 then
      raise exception 'Prix négatif refusé pour la référence %', trim(r.reference)
        using errcode = '22023';
    end if;

    insert into public.articles_stock(
      entreprise_id, reference, designation, unite, prix_achat_ht, prix_vente_ht,
      seuil_alerte, emplacement, marque, code_barres
    )
    values (
      p_entreprise_id, trim(r.reference), trim(r.designation), coalesce(nullif(trim(r.unite), ''), 'u'),
      coalesce(r.prix_achat_ht, 0), coalesce(r.prix_vente_ht, 0),
      greatest(coalesce(r.seuil_alerte, 0), 0), nullif(trim(r.emplacement), ''),
      nullif(trim(r.marque), ''), nullif(trim(r.code_barres), '')
    )
    on conflict (entreprise_id, reference) do update set
      designation = excluded.designation,
      unite = excluded.unite,
      prix_achat_ht = coalesce(r.prix_achat_ht, public.articles_stock.prix_achat_ht),
      prix_vente_ht = coalesce(r.prix_vente_ht, public.articles_stock.prix_vente_ht),
      seuil_alerte = excluded.seuil_alerte,
      emplacement = coalesce(excluded.emplacement, public.articles_stock.emplacement),
      marque = coalesce(excluded.marque, public.articles_stock.marque),
      code_barres = coalesce(excluded.code_barres, public.articles_stock.code_barres),
      actif = true,
      updated_at = now()
    returning * into v_article;

    if nullif(trim(r.teinte), '') is not null then
      insert into public.article_teintes(entreprise_id, article_id, nom, reference, code_hex)
      values (
        p_entreprise_id, v_article.id, trim(r.teinte), nullif(trim(r.teinte_reference), ''),
        case when r.code_hex ~ '^#[0-9A-Fa-f]{6}$' then upper(r.code_hex) else null end
      )
      on conflict (article_id, nom) do update set
        reference = coalesce(excluded.reference, public.article_teintes.reference),
        code_hex = coalesce(excluded.code_hex, public.article_teintes.code_hex),
        actif = true;
    end if;

    if p_type = 'inventaire' and r.quantite is not null then
      v_souhaite := greatest(r.quantite, 0);
      v_delta := v_souhaite - v_article.quantite_stock;
      if v_delta <> 0 then
        insert into public.mouvements_stock(entreprise_id, article_id, type, quantite, date, motif)
        values (
          p_entreprise_id, v_article.id,
          case when v_delta > 0 then 'ajustement_plus' else 'ajustement_moins' end,
          abs(v_delta), current_date, 'Import inventaire'
        );
      end if;
    end if;

    v_nb := v_nb + 1;
  end loop;

  return v_nb;
end;
$$;

create or replace function public.importer_articles_stock(p_entreprise_id uuid, p_type text, p_lignes jsonb)
returns integer language plpgsql security definer set search_path = public as $$
begin
  if not public.a_permission(p_entreprise_id, 'gerer_stock') then
    raise exception 'Accès refusé';
  end if;

  -- Donnée tarifaire = une clé prix_achat_ht ou prix_vente_ht présente et non nulle.
  -- Le contrôle précède toute écriture : un refus ne laisse aucun article modifié.
  if jsonb_typeof(p_lignes) = 'array'
     and not public.a_permission(p_entreprise_id, 'gerer_prix_stock')
     and exists (
       select 1
       from jsonb_array_elements(p_lignes) as l(ligne)
       where jsonb_typeof(l.ligne) = 'object'
         and (coalesce(jsonb_typeof(l.ligne -> 'prix_achat_ht'), 'null') <> 'null'
           or coalesce(jsonb_typeof(l.ligne -> 'prix_vente_ht'), 'null') <> 'null')
     ) then
    raise exception 'Import refusé : les prix du stock (achat ou vente) exigent la permission gerer_prix_stock ; aucun article n''a été modifié'
      using errcode = '42501';
  end if;

  return public.importer_articles_stock_interne(p_entreprise_id, p_type, p_lignes);
end;
$$;

-- ACL réaffirmées (CREATE OR REPLACE les conserve ; les redire rend l'état explicite).
revoke all on function public.importer_articles_stock_interne(uuid, text, jsonb) from public, anon, authenticated;
revoke all on function public.importer_articles_stock(uuid, text, jsonb) from public, anon;
grant execute on function public.importer_articles_stock(uuid, text, jsonb) to authenticated;

-- 5. PostgREST ─────────────────────────────────────────────────────────────────
notify pgrst, 'reload schema';
