NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DISABLE_EMAIL_LOGIN=false
SUPABASE_SERVICE_ROLE_KEY=
# Assistant IA (devis, copilote, documents, dictée, messagerie, rentabilité).
# Clé sur platform.openai.com/api-keys. Jamais exposée au navigateur : utilisée
# uniquement dans les server actions et la route /api/assistant/chat.
OPENAI_API_KEY=
# Modèle à utiliser (voir platform.openai.com/docs/models). Optionnel : un défaut
# raisonnable est utilisé si absent, mais fixe-le explicitement en production.
OPENAI_MODEL=gpt-5.1
# Plafond d'appels IA par entreprise et par jour (protection contre l'emballement
# de coûts). Optionnel, 300 par défaut.
IA_PLAFOND_QUOTIDIEN=300
NEXT_PUBLIC_APP_URL=https://votre-domaine.fr
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Abonnement SaaS Liria -> entreprises clientes (Stripe Billing plateforme).
# Ce secret de webhook est distinct de STRIPE_WEBHOOK_SECRET utilisé par Connect.
STRIPE_WEBHOOK_ABONNEMENT_SECRET=
# essentiel/premium : anciens contrats gelés (cf. rapport de qualification V2 §2.3),
# conservés uniquement pour les entreprises qui les ont déjà. Les offres réellement
# commercialisées aujourd'hui sont mini/pro/business/entreprise ci-dessous
# (OFFRES_ABONNEMENT_COMMERCIALISEES, src/lib/stripe-abonnement.ts).
STRIPE_PRICE_ESSENTIEL_MENSUEL=
STRIPE_PRICE_ESSENTIEL_ANNUEL=
STRIPE_PRICE_PREMIUM_MENSUEL=
STRIPE_PRICE_PREMIUM_ANNUEL=
STRIPE_PRICE_MINI_MENSUEL=
STRIPE_PRICE_MINI_ANNUEL=
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_BUSINESS_MENSUEL=
STRIPE_PRICE_BUSINESS_ANNUEL=
STRIPE_PRICE_ENTREPRISE_MENSUEL=
STRIPE_PRICE_ENTREPRISE_ANNUEL=
# Phase variable : prix récurrents des comptes au-delà du quota de l’offre.
STRIPE_PRICE_COMPTE_SUP_ESSENTIEL_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_ESSENTIEL_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_PREMIUM_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_PREMIUM_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_MINI_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_MINI_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_PRO_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_PRO_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_BUSINESS_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_BUSINESS_ANNUEL=
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_MENSUEL=
STRIPE_PRICE_COMPTE_SUP_ENTREPRISE_ANNUEL=
# Configuration explicite du Portail Stripe (upgrade/downgrade self-service,
# mission "closure V3" section 5) : id créé par scripts/configurer-portail-stripe.mjs
# (étape manuelle, REMOTE STRIPE — jamais exécutée sans clé réelle). Laissé vide,
# le Portail utilise la configuration par défaut du compte (non restreinte aux
# offres commercialisées, non vérifiable localement).
STRIPE_PORTAL_CONFIGURATION_ID=
# Délai de grâce (jours) avant qu'un échec de paiement Stripe (past_due/unpaid)
# ne suspende réellement l'accès — mission "closure V3" section 6. 0 par défaut
# (comportement conservateur inchangé) : le produit n'a pas encore tranché sa
# durée, cf. docs/DECISIONS_TARIFICATION_NON_RECOMMANDEES.md. Ne s'applique
# jamais à une simple demande de confirmation 3-D Secure (payment_action_required),
# qui ne suspend plus dans tous les cas.
STRIPE_DELAI_GRACE_PAIEMENT_JOURS=0
# Option IA payante (comptes existants gratuits/permanents, nouveaux comptes : essai 15
# jours puis facturation automatique). Trois paliers au choix de l’entreprise (plafond
# d’appels IA/jour) ; prix récurrents dédiés, même intervalle que l’offre.
STRIPE_PRICE_OPTION_IA_100_MENSUEL=
STRIPE_PRICE_OPTION_IA_100_ANNUEL=
STRIPE_PRICE_OPTION_IA_300_MENSUEL=
STRIPE_PRICE_OPTION_IA_300_ANNUEL=
STRIPE_PRICE_OPTION_IA_ILLIMITE_MENSUEL=
STRIPE_PRICE_OPTION_IA_ILLIMITE_ANNUEL=
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Vercel l’envoie en Bearer à la tâche nocturne /api/cron/abonnements.
CRON_SECRET=

# Coffre bancaire : clé AES-256 générée avec `openssl rand -base64 32`.
# Ne jamais la changer sans procédure de rotation/rechiffrement des IBAN existants.
BANK_DATA_ENCRYPTION_KEY=

# Powens Pay (contrat plateforme requis). Utiliser les URL du domaine remis par Powens.
POWENS_API_BASE_URL=https://votre-domaine.biapi.pro/2.0
POWENS_WEBVIEW_BASE_URL=https://votre-domaine.biapi.pro/2.0/auth/webview/payment
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=

# Secret d’au moins 32 caractères pour le dépôt serveur-à-serveur des bulletins
# par l’intégration de l’expert-comptable. Ne jamais le transmettre par email.
PAYROLL_IMPORT_SECRET=

# Notifications push navigateur. Clés VAPID générées avec `npx web-push generate-vapid-keys`
# (ou via le script fourni) — la clé publique est aussi lisible côté serveur (pas exposée au
# bundle client, transmise à la page via props). VAPID_SUBJECT = "mailto:contact@..." requis
# par la spec Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@liria-gestion-pro.fr
# Secret partagé avec le Database Webhook Supabase (Dashboard > Database > Webhooks) qui
# déclenche l’envoi en temps réel sur chaque nouvelle notification. Voir le header
# x-notifications-secret attendu par /api/webhooks/notifications-push.
NOTIFICATIONS_WEBHOOK_SECRET=

# Supervision Sentry. Le DSN n'est pas une clé d'authentification mais reste
# configuré explicitement pour garantir que les événements arrivent au bon projet.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Jeton réservé au build pour l'envoi des source maps. Ne jamais l'exposer au navigateur.
SENTRY_AUTH_TOKEN=
